---
import { LikeC4View } from "likec4:react";

interface Props {
  viewId: string;
  dynamicVariant?: "diagram" | "sequence";
  id?: string;
}

const { viewId, dynamicVariant, id } = Astro.props;
---

<div class="likec4-shell" id={id} data-dynamic-variant={dynamicVariant}>
  <LikeC4View
    client:only="react"
    viewId={viewId}
    dynamicViewVariant={dynamicVariant}
    enableDynamicViewWalkthrough={dynamicVariant === "sequence"}
  />
</div>
