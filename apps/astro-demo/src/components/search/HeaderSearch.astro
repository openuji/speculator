<div class="header-search-wrap" data-search-root>
  <label for="header-search-input" class="sr-only">Search specs</label>
  <input
    id="header-search-input"
    type="search"
    class="header-search-input"
    placeholder="Search specs"
    autocomplete="off"
    spellcheck="false"
    data-search-header-input
  />
  <button
    type="button"
    class="header-search-shortcut"
    aria-label="Open search dialog"
    data-search-open
  >
    <span>⌘</span><span>K</span>
  </button>
</div>

<button
  type="button"
  class="header-search-mobile"
  aria-label="Open search dialog"
  data-search-open
>
  Search
</button>
