---
import ThemeLayout from "@/layouts/ThemeLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import Panel from "@/components/ui/Panel.astro";
import TocNav from "@/components/renderers/TocNav.astro";
import BlockRenderer from "@/components/renderers/BlockRenderer.astro";
import { loadDemoSpec } from "@/lib/load-demo-spec";

const { document, toc, headingNumbers, statementsJsonLd } = await loadDemoSpec();
const metadata = (document.metadata || {}) as Record<string, unknown>;
---

<ThemeLayout title="Renderer Playground | Speculator Studio Theme">
  <section class="section !mt-0">
    <Badge tone="accent">Renderer Playground</Badge>
    <h2 class="mt-2.5">Speculator AST rendered through local UI blocks</h2>
    <p>
      This page demonstrates how `BlockRenderer` and `InlineRenderer` integrate with
      local shadcn-style primitives in Astro.
    </p>
  </section>

  <div class="spec-layout fade-up">
    <TocNav entries={toc} />

    <article class="spec-article">
      <header class="spec-header">
        <h1>{String(metadata.title || "Sample Specification")}</h1>
        <p>{String(metadata.abstract || "")}</p>
      </header>

      <div class="spec-prose">
        {document.children.map((child) => (
          <BlockRenderer
            node={child}
            headingNumbers={headingNumbers}
            basePath="/playground"
          />
        ))}
      </div>
    </article>
  </div>

  {
    statementsJsonLd && (
      <section class="section">
        <Panel title="Extracted JSON-LD" description="Computed by Speculator from <spec-statement> blocks.">
          <pre class="ui-code-block"><code>{JSON.stringify(statementsJsonLd, null, 2)}</code></pre>
        </Panel>
      </section>
    )
  }
</ThemeLayout>
