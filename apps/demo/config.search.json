{
    "routing": {
        "strategy": "map",
        "map": {
            "spec/index.md": "/",
            "spec/workspace/pkg-a/index.html": "/workspace/pkg-a",
            "spec/workspace/pkg-b/index.html": "/workspace/pkg-b"
        },
        "fallback": "/"
    },
    "search": {
        "mode": "raw",
        "outputPath": "public/search-index.json",
        "filters": {
            "enabled": true,
            "fields": [
                "documentType",
                "sectionType"
            ]
        }
    }
}