---
import { speculate, corePlugins, NodeFileProvider } from "@openuji/speculator";
import BlockRenderer from "../components/BlockRenderer.astro";
import Layout from "../layouts/Layout.astro";
import path from "path";

// Setup Speculator
const specDir = path.resolve("spec");
const entryFile = path.join(specDir, "index.md");
const configFile = path.join(specDir, "config.respec.json");

console.log(`Loading spec from: ${entryFile}`);

// Run the full pipeline with plugins
const result = await speculate({
    entry: entryFile,
    configPath: configFile,
    plugins: corePlugins,
    fileProvider: new NodeFileProvider(),
});

if (result.hasErrors) {
    console.error("Pipeline errors:", result.diagnostics);
}

const document = result.workspace?.documents[0];
if (!document) {
    throw new Error(
        "Pipeline failed to produce a document: " +
            JSON.stringify(result.diagnostics, null, 2),
    );
}

console.log(document);
const config = document.metadata || {};
---

<Layout title={config.title || "Speculator Demo"}>
    <header class="spec-header">
        <h1>{config.title}</h1>
        {config.subtitle && <p class="subtitle">{config.subtitle}</p>}

        <div class="metadata">
            <dl>
                {
                    config.status && (
                        <>
                            <dt>Status:</dt>
                            <dd>{config.status}</dd>
                        </>
                    )
                }
                {
                    config.editors && config.editors.length > 0 && (
                        <>
                            <dt>Editors:</dt>
                            <dd>
                                {config.editors.map((editor, i) => (
                                    <span>
                                        {editor.url ? (
                                            <a href={editor.url}>
                                                {editor.name}
                                            </a>
                                        ) : (
                                            editor.name
                                        )}
                                        {i < config.editors!.length - 1
                                            ? ", "
                                            : ""}
                                    </span>
                                ))}
                            </dd>
                        </>
                    )
                }
                {
                    config.abstract && (
                        <>
                            <dt>Abstract:</dt>
                            <dd>{config.abstract}</dd>
                        </>
                    )
                }
            </dl>
        </div>
    </header>

    <hr />

    <div class="spec-content">
        {document.children.map((child) => <BlockRenderer node={child} />)}
    </div>
</Layout>

<style>
    .spec-header {
        margin-bottom: 2rem;
    }
    .metadata dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.5rem 1rem;
        margin-top: 1rem;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }
    .metadata dt {
        font-weight: bold;
        color: var(--text-primary);
    }
</style>
