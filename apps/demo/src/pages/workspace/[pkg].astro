---
import {
    SpeculatorPipeline,
    corePlugins,
    NodeFileProvider,
    type Document,
} from "@openuji/speculator";
import BlockRenderer from "../../components/BlockRenderer.astro";
import "../../styles/global.css";
import path from "path";

export async function getStaticPaths() {
    return [{ params: { pkg: "pkg-a" } }, { params: { pkg: "pkg-b" } }];
}

const { pkg } = Astro.params;

// Setup Speculator for Workspace
const specRoot = path.resolve("spec/workspace");
const fileProvider = new NodeFileProvider();

const pipeline = new SpeculatorPipeline(corePlugins);

const result = await pipeline.runWorkspace({
    entries: [
        { entry: path.join(specRoot, "pkg-a/index.html") },
        { entry: path.join(specRoot, "pkg-b/index.html") },
    ],
    fileProvider,
});

const workspace = result.workspace;
const docs = workspace?.documents || [];

// Find the doc matching the pkg
const document = docs.find((d) => {
    const docPath = d.sourcePos?.file || "";
    // pkg is the name of the directory
    return path.basename(path.dirname(docPath)) === pkg;
});

if (!document) {
    return Astro.redirect("/404");
}

const config = document.metadata || {};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{config.title || pkg} - Speculator Workspace</title>
    </head>
    <body>
        <div class="container">
            <header class="spec-header">
                <nav class="nav">
                    <a href="/">Home</a>
                    <a href="/workspace">Workspace Index</a>
                    <span class="sep">/</span>
                    <span class="current">{pkg}</span>
                </nav>
                <h1>{config.title}</h1>
                {config.subtitle && <p class="subtitle">{config.subtitle}</p>}

                <div class="metadata">
                    <p>
                        <strong>Path:</strong>
                        <code>{document.sourcePos?.file}</code>
                    </p>
                </div>

                {
                    result.diagnostics.length > 0 && (
                        <section class="diagnostics">
                            <h2>Diagnostics</h2>
                            <ul>
                                {result.diagnostics.map((d) => (
                                    <li class={d.severity}>
                                        <strong>[{d.code}]</strong> {d.message}
                                        {d.file && (
                                            <span class="loc">({d.file})</span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }
            </header>

            <hr />

            <main class="spec-content">
                {
                    document.children.map((child) => (
                        <BlockRenderer
                            node={child}
                            workspace={workspace}
                            documentPath={document.sourcePos?.file}
                        />
                    ))
                }
            </main>

            <footer>
                <hr />
                <p>Generated by Speculator (Multi-page Workspace)</p>
            </footer>
        </div>
    </body>
</html>

<style>
    .nav {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 2rem;
    }
    .sep {
        color: var(--text-secondary);
    }
    .current {
        font-weight: bold;
    }
    .metadata {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-top: 1rem;
    }
    .diagnostics {
        margin-top: 2rem;
        padding: 1rem;
        background: #fff5f5;
        border: 1px solid #feb2b2;
        border-radius: 4px;
    }
    .diagnostics h2 {
        font-size: 1rem;
        margin-top: 0;
        color: #c53030;
    }
    .diagnostics ul {
        margin: 0;
        padding-left: 1.5rem;
    }
    .diagnostics li {
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }
    .diagnostics li.error {
        color: #c53030;
    }
    .diagnostics li.warning {
        color: #9b2c2c;
    }
    .loc {
        font-family: monospace;
        font-size: 0.8rem;
        color: #718096;
        margin-left: 0.5rem;
    }
</style>
