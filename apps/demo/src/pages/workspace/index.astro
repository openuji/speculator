---
import {
    SpeculatorPipeline,
    corePlugins,
    NodeFileProvider,
    type Document,
} from "@openuji/speculator";

import BlockRenderer from "../../components/BlockRenderer.astro";

import "../../styles/global.css";
import path from "path";

// Setup Speculator for Workspace
const specDir = path.resolve("spec/workspace");
const fileProvider = new NodeFileProvider();

const pipeline = new SpeculatorPipeline(corePlugins);

const result = await pipeline.runWorkspace({
    entries: [
        { entry: path.join(specDir, "pkg-a/index.html") },
        { entry: path.join(specDir, "pkg-b/index.html") },
    ],

    fileProvider,
});

const workspace = result.workspace;
const docs: Document[] = workspace?.documents || [];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Speculator Workspace Demo</title>
    </head>
    <body>
        <div class="container">
            <header class="spec-header">
                <nav class="nav">
                    <a href="/">Home</a>
                    <a href="/workspace">Workspace Demo</a>
                </nav>
                <h1>Multi-Spec Workspace Demo</h1>
                <p class="subtitle">
                    Demonstrating cross-document reference resolution
                </p>
                <div class="workspace-summary">
                    <p>
                        Total Documents: <strong>{docs.length}</strong>
                    </p>
                </div>

                {
                    result.diagnostics.length > 0 && (
                        <section class="diagnostics">
                            <h2>Workspace Diagnostics</h2>
                            <ul class="diag-list">
                                {result.diagnostics.map((d) => (
                                    <li class={d.severity}>
                                        <strong>[{d.code}]</strong> {d.message}
                                        {d.file && (
                                            <span class="loc">
                                                ({path.basename(d.file)})
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }
            </header>

            <div class="workspace-landing">
                <p>Select a specification to view:</p>
                <ul class="spec-list">
                    {
                        docs.map((document) => {
                            const docPath = document.sourcePos?.file || "";
                            const pkg = path.basename(path.dirname(docPath));
                            const title = document.metadata?.title || pkg;
                            return (
                                <li>
                                    <a href={`/workspace/${pkg}`}>
                                        <strong>{title}</strong>
                                        <span class="path">
                                            ({pkg}/index.html)
                                        </span>
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>
            </div>

            <footer>
                <hr />
                <p>Generated by Speculator Workspace Runner</p>
            </footer>
        </div>
    </body>
</html>

<style>
    .workspace-layout {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        margin-top: 2rem;
    }
    .document-section {
        border-left: 4px solid var(--accent);
        padding-left: 2rem;
    }
    .doc-path {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }
    .spec-header {
        margin-bottom: 2rem;
    }
    .nav {
        margin-bottom: 1rem;
        display: flex;
        gap: 1rem;
    }
    .diagnostics {
        margin-top: 2rem;
        padding: 1rem;
        background: #fff5f5;
        border: 1px solid #feb2b2;
        border-radius: 4px;
        max-width: 800px;
    }
    .diagnostics h2 {
        font-size: 1rem;
        margin-top: 0;
        color: #c53030;
    }
    .diag-list {
        margin: 0;
        padding-left: 1.5rem;
    }
    .diag-list li {
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }
    .diag-list li.error {
        color: #c53030;
    }
    .diag-list li.warning {
        color: #9b2c2c;
    }
    .loc {
        font-family: monospace;
        font-size: 0.8rem;
        color: #718096;
        margin-left: 0.5rem;
    }
</style>
