---
import {
  SpeculatorPipeline,
  corePlugins,
  NodeFileProvider,
  sortEntriesByDeps,
  type Document,
  type Workspace,
  type WorkspaceConfig,
} from "@openuji/speculator";

import {
  SpeculatorLinter,
  builtInRules,
  recommendedConfig,
  type LintDiagnostic,
} from "@openuji/speculator-lint";

import "@/styles/global.css";
import Layout from "@/layouts/Layout.astro";
import path from "path";
import { readFileSync } from "fs";

// Setup Speculator for Workspace
const fileProvider = new NodeFileProvider();

// Load workspace configuration
const configPath = path.resolve("speculator.workspace.json");
const workspaceConfig = JSON.parse(readFileSync(configPath, "utf-8"));

const pipeline = new SpeculatorPipeline(corePlugins);
const linter = new SpeculatorLinter(builtInRules);

const processedWorkspaces = await Promise.all(
  Object.entries(workspaceConfig as WorkspaceConfig).map(
    async ([name, entries]) => {
      // Sort and Build
      const sortResult = await sortEntriesByDeps(entries, fileProvider);
      const buildResult = await pipeline.runWorkspace({
        entries: sortResult.entries,
        fileProvider,
      });

      const workspace = buildResult.workspace;
      let diagnostics: LintDiagnostic[] = [];

      if (workspace) {
        const documentLevels = new Map<string, number>();
        workspace.documents.forEach((doc, index) => {
          const path = doc.sourcePos?.file || "";
          if (path) documentLevels.set(path, index);
        });

        const lintResult = await linter.lint({
          workspace,
          documentLevels,
          config: recommendedConfig,
        });
        diagnostics = lintResult.diagnostics;
      }

      return {
        name,
        workspace,
        docs: workspace?.documents || [],
        diagnostics,
      };
    },
  ),
);

const allDiagnostics = processedWorkspaces.flatMap((w) => w.diagnostics);
const allDocs = processedWorkspaces.flatMap((w) =>
  w.docs instanceof Map
    ? Array.from(w.docs.values())
    : Array.from(w.docs as any),
);

const htmlWorkspace = processedWorkspaces.find(
  (w) => w.name === "specWorkspace",
);
const mdWorkspace = processedWorkspaces.find((w) => w.name === "mdWorkspace");
---

<Layout title="Speculator Workspace Demo">
  <header class="spec-header">
    <h1>Multi-Spec Workspace Demo</h1>
    <p class="subtitle">Demonstrating isolation between named spec groups</p>
    <div class="workspace-summary">
      <p>
        Total Workspaces: <strong>{processedWorkspaces.length}</strong> | Total Documents:
        <strong>{allDocs.length}</strong>
      </p>
    </div>

    {
      allDiagnostics.length > 0 && (
        <section class="diagnostics">
          <h2>Workspace Diagnostics ({allDiagnostics.length})</h2>
          <ul class="diag-list">
            {allDiagnostics.map((d) => (
              <li class={d.severity}>
                <strong>[{d.code}]</strong> {d.message}
                {d.file && <span class="loc">({path.basename(d.file)})</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </header>

  <div class="workspace-landing">
    {
      htmlWorkspace && (
        <div class="workspace-group">
          <h3>Html Workspace: {htmlWorkspace?.name}</h3>
          <ul class="spec-list">
            {htmlWorkspace?.docs.map((document: Document) => {
              const docPath = document.sourcePos?.file || "";
              const pkg = path.basename(path.dirname(docPath));
              const title = document.metadata?.title || pkg;
              return (
                <li>
                  <a href={`/workspace/${pkg}`}>
                    <strong>{title}</strong>
                    <span class="path">({pkg})</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
    {
      mdWorkspace && (
        <div class="workspace-group">
          <h3>Markdown Workspace: {mdWorkspace?.name}</h3>
          <ul class="spec-list">
            {mdWorkspace?.docs.map((document: Document) => {
              const docPath = document.sourcePos?.file || "";
              const pkg = path.basename(path.dirname(docPath));
              const title = document.metadata?.title || pkg;
              return (
                <li>
                  <a href={`/workspace/md/${pkg}`}>
                    <strong>{title}</strong>
                    <span class="path">({pkg})</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .workspace-layout {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 2rem;
  }
  .document-section {
    border-left: 4px solid var(--accent);
    padding-left: 2rem;
  }
  .doc-path {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .spec-header {
    margin-bottom: 2rem;
  }
  .diagnostics {
    margin-top: 2rem;
    padding: 1rem;
    background: #fff5f5;
    border: 1px solid #feb2b2;
    border-radius: 4px;
    max-width: 800px;
  }
  .diagnostics h2 {
    font-size: 1rem;
    margin-top: 0;
    color: #c53030;
  }
  .diag-list {
    margin: 0;
    padding-left: 1.5rem;
  }
  .diag-list li {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .diag-list li.error {
    color: #c53030;
  }
  .diag-list li.warning {
    color: #9b2c2c;
  }
  .loc {
    font-family: monospace;
    font-size: 0.8rem;
    color: #718096;
    margin-left: 0.5rem;
  }
  .lint-info {
    font-size: 0.85rem;
    color: #2d3748;
    margin: 0.5rem 0;
    font-style: italic;
  }
</style>
