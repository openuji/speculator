---
import "../styles/global.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Search Demo - Speculator</title>
    </head>
    <body>
        <div class="container">
            <header>
                <h1>Speculator Search Demo</h1>
                <nav>
                    <a href="/">← Back to Spec</a>
                </nav>
            </header>

            <main>
                <div class="search-box">
                    <input
                        type="text"
                        id="searchInput"
                        placeholder="Search specification..."
                        autocomplete="off"
                    />
                    <div id="status" class="status"></div>
                </div>

                <div id="results" class="results"></div>
            </main>
        </div>

        <script>
            // Pure client-side search implementation
            let searchIndex = null;
            let isLoading = false;

            const searchInput = document.getElementById("searchInput");
            const resultsDiv = document.getElementById("results");
            const statusDiv = document.getElementById("status");

            // Load search index (static JSON file)
            async function loadSearchIndex() {
                if (searchIndex) return searchIndex;
                if (isLoading) return null;

                isLoading = true;
                statusDiv.textContent = "Loading search index...";
                statusDiv.className = "status loading";

                try {
                    const response = await fetch("/search-index.json");
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    searchIndex = await response.json();
                    statusDiv.textContent = "";
                    statusDiv.className = "status";
                    console.log("✅ Search index loaded:", searchIndex);
                    return searchIndex;
                } catch (error) {
                    statusDiv.textContent = `⚠️ Failed to load search index: ${error.message}`;
                    statusDiv.className = "status error";
                    console.error("Search index load error:", error);
                    return null;
                } finally {
                    isLoading = false;
                }
            }

            // Client-side search (simple text matching)
            async function performSearch() {
                const query = searchInput.value.trim();

                if (!query) {
                    resultsDiv.innerHTML = "";
                    statusDiv.textContent = "";
                    statusDiv.className = "status";
                    return;
                }

                const index = await loadSearchIndex();
                if (!index) return;

                resultsDiv.innerHTML = '<p class="searching">Searching...</p>';

                const results = [];
                // API-compatible normalization (lowercase, remove punctuation)
                const normalize = (text) =>
                    text
                        .toLowerCase()
                        .replace(/[^\w\s-]/g, "")
                        .trim();
                const queryNormalized = normalize(query);

                // Simple text search across all entries
                for (const doc of index.documents) {
                    const docRoute = doc.route;

                    for (const entry of doc.entries) {
                        if (
                            entry.plainText &&
                            entry.plainText.includes(queryNormalized)
                        ) {
                            const anchor = entry.anchor || "";
                            // Place query param before anchor hash
                            const url = `${docRoute}?q=${encodeURIComponent(query)}${anchor}`;

                            results.push({
                                ...entry,
                                documentTitle: doc.title,
                                documentRoute: doc.route,
                                url,
                            });
                        }
                    }
                }

                displayResults(results, query);
            }

            // Display search results
            function displayResults(results, query) {
                if (results.length === 0) {
                    resultsDiv.innerHTML =
                        '<p class="no-results">No results found</p>';
                    statusDiv.textContent = "";
                    statusDiv.className = "status";
                    return;
                }

                const html = results
                    .map((result) => {
                        // Highlight query in text preview
                        const highlighted = highlightText(
                            result.text || "",
                            query,
                        );
                        const contextPath = result.context?.headingPath
                            ? result.context.headingPath.join(" › ")
                            : result.context?.sectionTitle || "Document";

                        return `
            <div class="result-item">
              <div class="result-header">
                <a href="${result.url}" class="result-link">
                  ${contextPath}
                </a>
                <span class="result-type">${result.filters?.nodeType || "content"}</span>
              </div>
              <p class="result-preview">${highlighted}</p>
              <small class="result-meta">
                Location: ${result.anchor || "top"}
              </small>
            </div>
          `;
                    })
                    .join("");

                resultsDiv.innerHTML = html;
                statusDiv.innerHTML = `
          <span class="results-count">
            Found <strong>${results.length}</strong> result${results.length !== 1 ? "s" : ""}
          </span>
        `;
                statusDiv.className = "status success";
            }

            // Highlight query in text
            function highlightText(text, query) {
                if (!text || !query) return text;

                const escapedQuery = query.replace(
                    /[.*+?^${}()|[\]\\]/g,
                    "\\$&",
                );
                const regex = new RegExp(`(${escapedQuery})`, "gi");
                return text.replace(regex, "<mark>$1</mark>");
            }

            // Debounce helper
            function debounce(fn, delay) {
                let timeout;
                return function (...args) {
                    clearTimeout(timeout);
                    timeout = setTimeout(() => fn(...args), delay);
                };
            }

            // Event listeners
            searchInput.addEventListener("input", debounce(performSearch, 300));

            // Pre-load index on page load
            loadSearchIndex();
        </script>

        <style>
            :root {
                --primary: #0066cc;
                --bg: #ffffff;
                --bg-secondary: #f5f5f5;
                --border: #ddd;
                --text: #333;
                --text-secondary: #666;
                --text-muted: #999;
                --success: #28a745;
                --error: #dc3545;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    Oxygen, Ubuntu, Cantarell, sans-serif;
                line-height: 1.6;
                color: var(--text);
                background: var(--bg);
                margin: 0;
                padding: 0;
            }

            .container {
                max-width: 900px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            header {
                margin-bottom: 2rem;
                padding-bottom: 1rem;
                border-bottom: 2px solid var(--border);
            }

            header h1 {
                margin: 0 0 0.5rem;
                color: var(--primary);
            }

            nav a {
                color: var(--primary);
                text-decoration: none;
            }

            nav a:hover {
                text-decoration: underline;
            }

            .search-box {
                margin-bottom: 2rem;
            }

            #searchInput {
                width: 100%;
                padding: 1rem;
                font-size: 1.1rem;
                border: 2px solid var(--border);
                border-radius: 8px;
                outline: none;
                transition: border-color 0.2s;
            }

            #searchInput:focus {
                border-color: var(--primary);
            }

            .status {
                margin-top: 0.75rem;
                padding: 0.5rem;
                border-radius: 4px;
                font-size: 0.95rem;
            }

            .status.loading {
                background: #e3f2fd;
                color: #1976d2;
            }

            .status.success {
                background: #e8f5e9;
                color: var(--success);
            }

            .status.error {
                background: #ffebee;
                color: var(--error);
            }

            .status:empty {
                display: none;
            }

            .results-count {
                font-weight: normal;
            }

            .results-count strong {
                font-weight: 600;
            }

            .results {
                margin-top: 1.5rem;
            }

            .searching,
            .no-results {
                text-align: center;
                padding: 3rem 1rem;
                color: var(--text-secondary);
                font-size: 1.1rem;
            }

            .result-item {
                background: white;
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 1.25rem;
                margin-bottom: 1rem;
                transition: all 0.2s;
            }

            .result-item:hover {
                border-color: var(--primary);
                box-shadow: 0 2px 8px rgba(0, 102, 204, 0.1);
            }

            .result-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 0.75rem;
                gap: 1rem;
            }

            .result-link {
                color: var(--primary);
                text-decoration: none;
                font-weight: 500;
                font-size: 1.05rem;
                flex: 1;
            }

            .result-link:hover {
                text-decoration: underline;
            }

            .result-type {
                font-size: 0.8rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .result-preview {
                margin: 0 0 0.5rem;
                line-height: 1.6;
                color: var(--text);
            }

            mark {
                background: #ffeb3b;
                padding: 0.1em 0.3em;
                border-radius: 3px;
                font-weight: 500;
            }

            .result-meta {
                display: block;
                color: var(--text-muted);
                font-size: 0.85rem;
            }

            @media (max-width: 600px) {
                .container {
                    padding: 1rem 0.5rem;
                }

                .result-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.25rem;
                }
            }
        </style>
    </body>
</html>
