---
import { Preprocess, Parse, NodeFileProvider } from '@openuji/speculator';
import BlockRenderer from '../components/BlockRenderer.astro';
import '../styles/global.css';
import path from 'path';

// Setup Speculator
const fileProvider = new NodeFileProvider();
const specDir = path.resolve('spec');
const entryFile = path.join(specDir, 'index.html');
const configFile = path.join(specDir, 'config.respec.json');

console.log(`Loading spec from: ${entryFile}`);

// 1. Preprocess
const preprocessResult = await Preprocess.preprocess({
    entry: entryFile,
    configPath: configFile,
    fileProvider
});

if (preprocessResult.hasErrors) {
    console.error('Preprocess errors:', preprocessResult.diagnostics);
    throw new Error('Preprocess failed: ' + JSON.stringify(preprocessResult.diagnostics, null, 2));
}

// 2. Parse
const parseResult = Parse.parse(preprocessResult.result!);

if (parseResult.hasErrors) {
    console.error('Parse errors:', parseResult.diagnostics);
     if (!parseResult.result) {
        throw new Error('Parse failed completely');
     }
}

const { document, config } = parseResult.result!;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.title || 'Speculator HTML Demo'}</title>
	</head>
	<body>
        <div class="container">
            <header class="spec-header">
                <nav class="nav">
                    <a href="/">Markdown Version</a>
                    <a href="/html">HTML Version</a>
                </nav>

                <h1>{config.title} (HTML Source)</h1>
                {config.subtitle && <p class="subtitle">{config.subtitle}</p>}
                
                <div class="metadata">
                    <dl>
                        {config.status && (
                            <>
                                <dt>Status:</dt>
                                <dd>{config.status}</dd>
                            </>
                        )}
                         {config.abstract && (
                            <>
                                <dt>Abstract:</dt>
                                <dd>{config.abstract}</dd>
                            </>
                        )}
                    </dl>
                </div>
            </header>

            <hr />

            <main class="spec-content">
                {document.children.map(child => <BlockRenderer node={child} />)}
            </main>
            
            <footer>
                <hr />
                <p>Generated by Speculator from HTML source</p>
            </footer>
        </div>
	</body>
</html>

<style>
    .spec-header {
        margin-bottom: 2rem;
    }
    .metadata dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.5rem 1rem;
        margin-top: 1rem;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }
    .metadata dt {
        font-weight: bold;
        color: var(--text-primary);
    }
</style>
