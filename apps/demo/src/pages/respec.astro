---
import { renderRespec } from "@openuji/render-respec";
import { readFile } from "fs/promises";
import { join } from "path";

const specPath = join(process.cwd(), "spec", "sample-respec.md");
const configPath = join(process.cwd(), "spec", "config.respec.json");
const outputPath = join(process.cwd(), "public", "respec-output.html");

// Render the spec
const result = await renderRespec({
    input: specPath,
    config: configPath,
    output: outputPath,
    strict: false,
});

// Read the generated HTML
let renderedHTML = "";
let diagnosticsInfo = "";

if (result.success && result.outputPath) {
    renderedHTML = await readFile(result.outputPath, "utf-8");

    if (result.diagnostics && result.diagnostics.length > 0) {
        const errorCount = result.diagnostics.filter(
            (d: any) => d.severity === "error",
        ).length;
        const warningCount = result.diagnostics.filter(
            (d: any) => d.severity === "warning",
        ).length;
        diagnosticsInfo = `${errorCount} error(s), ${warningCount} warning(s)`;
    } else {
        diagnosticsInfo = "No issues found";
    }
} else {
    renderedHTML = `<div class="error"><h2>Rendering Failed</h2><pre>${result.errors?.join("\n")}</pre></div>`;
}

// Read source files for display
const specSource = await readFile(specPath, "utf-8");
const configSource = await readFile(configPath, "utf-8");
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>ReSpec Renderer Demo</title>
        <meta name="viewport" content="width=device-width" />
        <style>
            :root {
                --color-bg: #0a0a0a;
                --color-surface: #1a1a1a;
                --color-border: #333;
                --color-text: #e0e0e0;
                --color-heading: #fff;
                --color-accent: #4a9eff;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    sans-serif;
                background: var(--color-bg);
                color: var(--color-text);
                line-height: 1.6;
            }

            .container {
                max-width: 1400px;
                margin: 0 auto;
                padding: 20px;
            }

            header {
                border-bottom: 2px solid var(--color-border);
                padding-bottom: 20px;
                margin-bottom: 30px;
            }

            h1 {
                color: var(--color-heading);
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            .subtitle {
                color: #888;
                font-size: 1.1em;
            }

            nav {
                margin: 20px 0;
            }

            nav a {
                color: var(--color-accent);
                text-decoration: none;
                margin-right: 15px;
            }

            nav a:hover {
                text-decoration: underline;
            }

            .status {
                padding: 10px 15px;
                background: var(--color-surface);
                border-left: 4px solid var(--color-accent);
                margin: 20px 0;
            }

            .status strong {
                color: var(--color-accent);
            }

            .grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin: 20px 0;
            }

            .panel {
                background: var(--color-surface);
                border: 1px solid var(--color-border);
                border-radius: 8px;
                overflow: hidden;
            }

            .panel-header {
                padding: 15px 20px;
                background: #252525;
                border-bottom: 1px solid var(--color-border);
                font-weight: 600;
                color: var(--color-heading);
            }

            .panel-content {
                padding: 20px;
                max-height: 400px;
                overflow-y: auto;
            }

            pre {
                background: #0d0d0d;
                padding: 15px;
                border-radius: 4px;
                overflow-x: auto;
                font-family: "Monaco", "Courier New", monospace;
                font-size: 0.9em;
            }

            .output-frame {
                grid-column: 1 / -1;
            }

            iframe {
                width: 100%;
                height: 800px;
                border: 1px solid var(--color-border);
                border-radius: 4px;
                background: white;
            }

            .error {
                color: #ff5555;
                padding: 20px;
            }

            @media (max-width: 768px) {
                .grid {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>
    <body>
        <div class="container">
            <header>
                <h1>🎨 ReSpec Renderer Demo</h1>
                <p class="subtitle">
                    Server-side ReSpec HTML generation using Speculator AST
                    pipeline
                </p>
                <nav>
                    <a href="/">← Back to Home</a>
                    <a href="/html">HTML Parser</a>
                    <a href="/workspace/ast">Workspace AST</a>
                </nav>
            </header>

            <div class="status">
                <strong>Status:</strong>
                {
                    result.success
                        ? "✅ Rendered successfully"
                        : "❌ Rendering failed"
                }
                {result.success && ` | Diagnostics: ${diagnosticsInfo}`}
            </div>

            <div class="grid">
                <div class="panel">
                    <div class="panel-header">📄 Source: sample-respec.md</div>
                    <div class="panel-content">
                        <pre>{specSource}</pre>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        ⚙️ Config: config.respec.json
                    </div>
                    <div class="panel-content">
                        <pre>{configSource}</pre>
                    </div>
                </div>

                <div class="panel output-frame">
                    <div class="panel-header">
                        📋 Rendered ReSpec HTML Output
                    </div>
                    <div
                        class="panel-content"
                        style="max-height: none; padding: 0;"
                    >
                        <iframe
                            srcdoc={renderedHTML}
                            title="Rendered ReSpec Output"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
