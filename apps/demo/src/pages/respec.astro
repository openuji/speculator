---
import { renderRespec } from "@openuji/render-respec";
import { readFile } from "fs/promises";
import { join } from "path";
import Layout from "../layouts/Layout.astro";

const specPath = join(process.cwd(), "spec", "sample-respec.md");
const configPath = join(process.cwd(), "spec", "config.json");
const outputPath = join(process.cwd(), "public", "respec-output.html");

// Render the spec
const result = await renderRespec({
    input: specPath,
    config: configPath,
    output: outputPath,
    strict: false,
});

// Read the generated HTML
let renderedHTML = "";
let diagnosticsInfo = "";

if (result.success && result.outputPath) {
    renderedHTML = await readFile(result.outputPath, "utf-8");

    if (result.diagnostics && result.diagnostics.length > 0) {
        const errorCount = result.diagnostics.filter(
            (d: any) => d.severity === "error",
        ).length;
        const warningCount = result.diagnostics.filter(
            (d: any) => d.severity === "warning",
        ).length;
        diagnosticsInfo = `${errorCount} error(s), ${warningCount} warning(s)`;
    } else {
        diagnosticsInfo = "No issues found";
    }
} else {
    renderedHTML = `<div class="error"><h2>Rendering Failed</h2><pre>${result.errors?.join("\n")}</pre></div>`;
}

// Read source files for display
const specSource = await readFile(specPath, "utf-8");
const configSource = await readFile(configPath, "utf-8");
const configData = JSON.parse(configSource);
const respecConfigSource = JSON.stringify(
    configData.respec || configData,
    null,
    2,
);
---

<Layout title="ReSpec Renderer Demo">
    <div class="respec-demo">
        <header class="page-header">
            <h1>🎨 ReSpec Renderer Demo</h1>
            <p class="subtitle">
                Server-side ReSpec HTML generation using Speculator AST pipeline
            </p>
        </header>

        <div class="status-bar">
            <strong>Status:</strong>
            {
                result.success
                    ? "✅ Rendered successfully"
                    : "❌ Rendering failed"
            }
            {result.success && ` | Diagnostics: ${diagnosticsInfo}`}
        </div>

        <div class="grid">
            <div class="panel">
                <div class="panel-header">📄 Source: sample-respec.md</div>
                <div class="panel-content">
                    <pre>{specSource}</pre>
                </div>
            </div>

            <div class="panel">
                <div class="panel-header">
                    ⚙️ Config: config.json (respec section)
                </div>
                <div class="panel-content">
                    <pre>{respecConfigSource}</pre>
                </div>
            </div>

            <div class="panel output-frame">
                <div class="panel-header">📋 Rendered ReSpec HTML Output</div>
                <div
                    class="panel-content"
                    style="max-height: none; padding: 0;"
                >
                    <iframe srcdoc={renderedHTML} title="Rendered ReSpec Output"
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .respec-demo {
        --color-bg: #0a0a0a;
        --color-surface: #1a1a1a;
        --color-border: #333;
        --color-text: #e0e0e0;
        --color-heading: #fff;
        --color-accent: #4a9eff;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    h1 {
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #888;
        font-size: 1.1em;
    }

    .status-bar {
        padding: 1rem;
        background: var(--bg-secondary);
        border-left: 4px solid var(--accent);
        margin: 1.5rem 0;
        border-radius: 0 4px 4px 0;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin: 20px 0;
        width: 100%;
    }

    .panel {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .panel-header {
        padding: 10px 15px;
        background: rgba(0, 0, 0, 0.2);
        border-bottom: 1px solid var(--border);
        font-weight: 600;
        color: var(--text-primary);
    }

    .panel-content {
        padding: 15px;
        max-height: 400px;
        overflow-y: auto;
        flex: 1;
    }

    pre {
        padding: 0;
        margin: 0;
        font-family: "Monaco", "Courier New", monospace;
        font-size: 0.85em;
        background: transparent;
        border: none;
    }

    .output-frame {
        grid-column: 1 / -1;
    }

    iframe {
        width: 100%;
        height: 800px;
        border: none;
        background: white;
        display: block;
    }

    .error {
        color: #ff5555;
        padding: 20px;
    }

    @media (max-width: 768px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
