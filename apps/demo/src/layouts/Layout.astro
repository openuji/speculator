---
import "../styles/global.css";
import Search from "../components/Search.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Speculator Demo",
  description = "Speculator Documentation and Demos",
} = Astro.props;

const navItems = [
  { href: "/", label: "Markdown Spec" },
  { href: "/html", label: "HTML Spec" },
  { href: "/respec", label: "ReSpec Renderer" },
  { href: "/workspace", label: "Workspace" },
  { href: "/search", label: "Search Page" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="app-layout">
      <header class="site-header">
        <div class="container header-inner">
          <div class="header-left">
            <a href="/" class="site-title"> Speculator </a>
          </div>

          <div class="header-right">
            <div class="search-wrapper">
              <Search />
            </div>
            <button id="menu-btn" class="menu-btn" aria-label="Open menu">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Mobile Navigation Overlay -->
      <div id="mobile-nav" class="mobile-nav-overlay">
        <nav class="mobile-nav-content">
          <div class="mobile-nav-header">
            <span class="mobile-nav-title">Menu</span>
            <button id="close-btn" class="close-btn" aria-label="Close menu">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="mobile-nav-links">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class={Astro.url.pathname === item.href ? "active" : ""}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </nav>
      </div>

      <main class="container main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container">
          <p>
            Generated by Speculator &copy; {new Date().getFullYear()}
          </p>
        </div>
      </footer>
    </div>

    <script>
      const menuBtn = document.getElementById("menu-btn");
      const mobileNav = document.getElementById("mobile-nav");
      const closeBtn = document.getElementById("close-btn");

      if (menuBtn && mobileNav && closeBtn) {
        menuBtn.addEventListener("click", () => {
          mobileNav.classList.add("open");
          document.body.style.overflow = "hidden";
        });

        closeBtn.addEventListener("click", () => {
          mobileNav.classList.remove("open");
          document.body.style.overflow = "";
        });

        // Close when clicking outside content
        mobileNav.addEventListener("click", (e) => {
          if (e.target === mobileNav) {
            mobileNav.classList.remove("open");
            document.body.style.overflow = "";
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .app-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    background-color: var(--bg-secondary, #1e293b);
    border-bottom: 1px solid var(--border, #334155);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    justify-content: flex-end;
  }

  .site-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary, #fff);
    text-decoration: none;
    background: linear-gradient(to right, var(--accent, #38bdf8), #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    white-space: nowrap;
  }

  .search-wrapper {
    width: 100%;
    max-width: 400px;
  }

  .menu-btn {
    background: none;
    border: none;
    color: var(--text-primary, #fff);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  /* Mobile Nav Overlay */
  .mobile-nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 100;
    opacity: 0;
    visibility: hidden; /* Hide by default so it doesn't block clicks */
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .mobile-nav-overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-content {
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 80%;
    height: 100%;
    background-color: var(--bg-secondary, #1e293b);
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-overlay.open .mobile-nav-content {
    transform: translateX(0);
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border, #334155);
  }

  .mobile-nav-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary, #fff);
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--text-secondary, #94a3b8);
    cursor: pointer;
    padding: 0.5rem;
  }

  .close-btn:hover {
    color: var(--text-primary, #fff);
  }

  .mobile-nav-links {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
  }

  .mobile-nav-links a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--text-secondary, #94a3b8);
    text-decoration: none;
    font-size: 1rem;
    border-radius: 4px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .mobile-nav-links a:hover,
  .mobile-nav-links a.active {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-primary, #fff);
  }

  .main-content {
    flex: 1;
    padding-top: 2rem;
    padding-bottom: 2rem;
    width: 100%;
  }

  .site-footer {
    padding: 2rem 0;
    border-top: 1px solid var(--border, #334155);
    margin-top: auto;
    color: var(--text-secondary, #94a3b8);
    text-align: center;
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    /* On small screens, flex handles the search wrapper, no explicit hide needed unless desired */
    .search-wrapper {
      display: block;
    }
  }
</style>
