---
/**
 * Table of Contents Sidebar Component
 *
 * Renders a hierarchical navigation from TOC entries as a sticky sidebar.
 */

import type { TocEntry } from "@openuji/speculator";

interface Props {
    toc: TocEntry[];
    title?: string;
}

const { toc, title = "Contents" } = Astro.props;
---

{
    toc && toc.length > 0 && (
        <aside class="toc-sidebar">
            <nav class="toc" aria-label={title}>
                <h2 class="toc-title">{title}</h2>
                <ol class="toc-list">
                    {toc.map((entry) => (
                        <li class="toc-item" data-depth={entry.depth}>
                            <a
                                href={entry.id ? `#${entry.id}` : "#"}
                                class="toc-link"
                            >
                                {entry.number && (
                                    <span class="toc-number">
                                        {entry.number}
                                    </span>
                                )}
                                <span class="toc-text">{entry.text}</span>
                            </a>
                            {entry.children && entry.children.length > 0 && (
                                <ol class="toc-sublist">
                                    {entry.children.map((child) => (
                                        <li
                                            class="toc-item"
                                            data-depth={child.depth}
                                        >
                                            <a
                                                href={
                                                    child.id
                                                        ? `#${child.id}`
                                                        : "#"
                                                }
                                                class="toc-link"
                                            >
                                                {child.number && (
                                                    <span class="toc-number">
                                                        {child.number}
                                                    </span>
                                                )}
                                                <span class="toc-text">
                                                    {child.text}
                                                </span>
                                            </a>
                                            {child.children &&
                                                child.children.length > 0 && (
                                                    <ol class="toc-sublist">
                                                        {child.children.map(
                                                            (grandchild) => (
                                                                <li
                                                                    class="toc-item"
                                                                    data-depth={
                                                                        grandchild.depth
                                                                    }
                                                                >
                                                                    <a
                                                                        href={
                                                                            grandchild.id
                                                                                ? `#${grandchild.id}`
                                                                                : "#"
                                                                        }
                                                                        class="toc-link"
                                                                    >
                                                                        {grandchild.number && (
                                                                            <span class="toc-number">
                                                                                {
                                                                                    grandchild.number
                                                                                }
                                                                            </span>
                                                                        )}
                                                                        <span class="toc-text">
                                                                            {
                                                                                grandchild.text
                                                                            }
                                                                        </span>
                                                                    </a>
                                                                </li>
                                                            ),
                                                        )}
                                                    </ol>
                                                )}
                                        </li>
                                    ))}
                                </ol>
                            )}
                        </li>
                    ))}
                </ol>
            </nav>
        </aside>
    )
}

<style>
    .toc-sidebar {
        position: sticky;
        top: 5rem;
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        padding-right: 1rem;
    }

    .toc {
        background: var(--bg-secondary, #1e293b);
        border: 1px solid var(--border, #334155);
        border-radius: 8px;
        padding: 1rem 1.25rem;
    }

    .toc-title {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 0.75rem 0;
        color: var(--text-secondary, #94a3b8);
        border-bottom: 1px solid var(--border, #334155);
        padding-bottom: 0.5rem;
    }

    .toc-list,
    .toc-sublist {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .toc-sublist {
        padding-left: 1rem;
        margin-top: 0.25rem;
        border-left: 1px solid var(--border, #334155);
    }

    .toc-item {
        margin: 0.125rem 0;
    }

    .toc-link {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.35rem 0.5rem;
        border-radius: 4px;
        text-decoration: none;
        color: var(--text-secondary, #94a3b8);
        font-size: 0.85rem;
        line-height: 1.4;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .toc-link:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-primary, #fff);
    }

    .toc-number {
        font-weight: 500;
        color: var(--accent, #38bdf8);
        font-size: 0.8em;
        min-width: 2rem;
        flex-shrink: 0;
    }

    .toc-text {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Depth-based styling */
    .toc-item[data-depth="1"] > .toc-link {
        font-weight: 500;
        color: var(--text-primary, #fff);
    }

    .toc-item[data-depth="2"] > .toc-link {
        font-size: 0.8rem;
    }

    .toc-item[data-depth="3"] > .toc-link {
        font-size: 0.75rem;
        color: var(--text-muted, #64748b);
    }

    /* Responsive: hide sidebar on small screens */
    @media (max-width: 1024px) {
        .toc-sidebar {
            display: none;
        }
    }
</style>
