---
import type { Inline, Workspace } from "@openuji/speculator";
import RecursiveInlineRenderer from "./InlineRenderer.astro";

interface Props {
  nodes: Inline[];
  workspace?: Workspace;
  basePath?: string;
}

const { nodes, workspace, basePath } = Astro.props;
---

{
  nodes.map((node) => {
    switch (node.type) {
      case "text":
        return <>{node.value}</>;

      case "emphasis":
        return (
          <em>
            <RecursiveInlineRenderer
              nodes={node.children}
              workspace={workspace}
              basePath={basePath}
            />
          </em>
        );

      case "strong":
        return (
          <strong>
            <RecursiveInlineRenderer
              nodes={node.children}
              workspace={workspace}
              basePath={basePath}
            />
          </strong>
        );

      case "inlineCode":
        return <code>{node.value}</code>;

      case "variable":
        return <var>{node.value}</var>;

      case "link":
        return (
          <a href={node.url} title={node.title || undefined}>
            <RecursiveInlineRenderer
              nodes={node.children}
              workspace={workspace}
              basePath={basePath}
            />
          </a>
        );

      case "image":
        return (
          <img src={node.url} alt={node.alt || ""} title={node.title || ""} />
        );

      case "definition":
        // Render <dfn> with ReSpec attributes
        const dfnId = (node as any).explicitId || (node as any).id;
        const dfnFor = (node as any).forContexts?.filter(Boolean).join(", ");
        const dfnType = (node as any).dfnType;
        return (
          <dfn
            id={dfnId}
            title={node.term}
            data-dfn-for={dfnFor || undefined}
            data-dfn-type={dfnType !== "dfn" ? dfnType : undefined}
          >
            <RecursiveInlineRenderer
              nodes={node.children}
              workspace={workspace}
              basePath={basePath}
            />
          </dfn>
        );

      case "reference":
        // Render cross-reference
        const ref = node as any;
        const targetId = ref.targetId;
        const preferredType = ref.preferredType;

        // Element and IDL references render as <code> tags, not links
        if (preferredType === "element" || preferredType === "idl") {
          const codeClass = preferredType === "element" ? "element" : "idl";
          return (
            <code class={codeClass} data-link-type={preferredType}>
              <RecursiveInlineRenderer
                nodes={ref.children}
                workspace={workspace}
                basePath={basePath}
              />
            </code>
          );
        }

        // Standard cross-references render as links
        let href = `#${targetId || ""}`;

        const dfns = workspace?.globalIndex?.definitions;
        if (dfns && targetId) {
          // Find which document contains this definition
          const targetDef = dfns.find((d) => d.id === targetId);
          href = `${basePath}#${targetId}`;
        }

        const xrefFor = ref.forContexts?.filter(Boolean).join(", ");
        return (
          <a
            href={href}
            class="xref"
            data-xref-for={xrefFor || undefined}
            title={ref.targetTerm}
          >
            <RecursiveInlineRenderer
              nodes={ref.children}
              workspace={workspace}
              basePath={basePath}
            />
          </a>
        );

      case "cite":
        // Render citation
        const cite = node as any;
        const citeClass = cite.forcedNormative
          ? "cite normative"
          : cite.forcedInformative
            ? "cite informative"
            : "cite";
        const citeHref =
          cite.url || (cite.targetId ? `#${cite.targetId}` : undefined);

        const citeContent =
          cite.children && cite.children.length > 0 ? (
            <RecursiveInlineRenderer
              nodes={cite.children}
              workspace={workspace}
              basePath={basePath}
            />
          ) : (
            <>[{cite.key}]</>
          );

        return citeHref ? (
          <a href={citeHref} class={citeClass} data-cite={cite.key}>
            {citeContent}
          </a>
        ) : (
          <cite class={citeClass} data-cite={cite.key}>
            {citeContent}
          </cite>
        );

      case "requirement":
        return (
          <span class="requirement" id={node.id}>
            {node.keyword}
          </span>
        );

      case "issue":
        return (
          <span
            class="issue"
            data-status={node.status}
            style="color: orange; border: 1px solid orange; padding: 2px; border-radius: 4px;"
          >
            Issue {node.id && `#${node.id}`}:{" "}
            <RecursiveInlineRenderer
              nodes={node.children}
              workspace={workspace}
              basePath={basePath}
            />
          </span>
        );

      default:
        return (
          <span style="color: red; border: 1px solid red;">
            [Unknown Inline: {(node as any).type}]
          </span>
        );
    }
  })
}
