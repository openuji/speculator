{
    "module": "ui",
    "namespace": "http://localhost:4321/vocab/ui/index.html#",
    "docBase": "http://localhost:4321/vocab/ui/index.html",
    "title": "User Journey Map UI Vocabulary",
    "description": "UI-specific vocabulary for visual representation and interactive manipulation of user journey maps in graphical editors.",
    "status": "ED",
    "updated": "2025-12-23",
    "terms": [
        {
            "id": "NodePosition",
            "kind": "Class",
            "label": "Node Position",
            "comment": "Visual position of a node (step) in the journey map canvas. Defines the x,y coordinates for rendering."
        },
        {
            "id": "EdgeStyle",
            "kind": "Class",
            "label": "Edge Style",
            "comment": "Visual styling for edges (transitions) in the journey map. Controls appearance such as color, width, and line type."
        },
        {
            "id": "CanvasViewport",
            "kind": "Class",
            "label": "Canvas Viewport",
            "comment": "Viewport state for the journey map canvas. Tracks zoom level and pan position for the visual editor."
        },
        {
            "id": "position",
            "kind": "Property",
            "label": "position",
            "comment": "The visual position of a step node in the canvas coordinate system.",
            "domain": "http://localhost:4321/vocab/ns#Step",
            "range": "http://localhost:4321/vocab/ui/index.html#NodePosition"
        },
        {
            "id": "x",
            "kind": "Property",
            "label": "x",
            "comment": "X coordinate of a node position in the canvas.",
            "domain": "http://localhost:4321/vocab/ui/index.html#NodePosition",
            "range": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        {
            "id": "y",
            "kind": "Property",
            "label": "y",
            "comment": "Y coordinate of a node position in the canvas.",
            "domain": "http://localhost:4321/vocab/ui/index.html#NodePosition",
            "range": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        {
            "id": "style",
            "kind": "Property",
            "label": "style",
            "comment": "The visual styling applied to a transition edge.",
            "domain": "http://localhost:4321/vocab/ns#Transition",
            "range": "http://localhost:4321/vocab/ui/index.html#EdgeStyle"
        },
        {
            "id": "color",
            "kind": "Property",
            "label": "color",
            "comment": "Color value for edge styling (e.g., hex color code).",
            "domain": "http://localhost:4321/vocab/ui/index.html#EdgeStyle",
            "range": "http://www.w3.org/2001/XMLSchema#string"
        },
        {
            "id": "width",
            "kind": "Property",
            "label": "width",
            "comment": "Line width for edge rendering in pixels.",
            "domain": "http://localhost:4321/vocab/ui/index.html#EdgeStyle",
            "range": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        {
            "id": "zoom",
            "kind": "Property",
            "label": "zoom",
            "comment": "Zoom level of the canvas viewport (1.0 = 100%).",
            "domain": "http://localhost:4321/vocab/ui/index.html#CanvasViewport",
            "range": "http://www.w3.org/2001/XMLSchema#decimal"
        }
    ],
    "context": {
        "NodePosition": {
            "@id": "http://localhost:4321/vocab/ui/index.html#NodePosition",
            "@type": "@id"
        },
        "EdgeStyle": {
