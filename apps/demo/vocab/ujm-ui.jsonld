        "x": {
            "@id": "http://localhost:4321/vocab/ui/index.html#x",
            "@type": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        "y": {
            "@id": "http://localhost:4321/vocab/ui/index.html#y",
            "@type": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        "style": "http://localhost:4321/vocab/ui/index.html#style",
        "color": "http://localhost:4321/vocab/ui/index.html#color",
        "width": {
            "@id": "http://localhost:4321/vocab/ui/index.html#width",
            "@type": "http://www.w3.org/2001/XMLSchema#decimal"
        },
        "zoom": {
            "@id": "http://localhost:4321/vocab/ui/index.html#zoom",
            "@type": "http://www.w3.org/2001/XMLSchema#decimal"
        }
    }
}