@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://localhost:4321/vocab/ui/index.html#>.

<http://localhost:4321/vocab/ui/index.html> a owl:Ontology;
    rdfs:label "User Journey Map UI Vocabulary";
    rdfs:comment "UI-specific vocabulary for visual representation and interactive manipulation of user journey maps in graphical editors.";
    owl:imports <https://ujm.specs.openuji.org/ns>.
:NodePosition a rdfs:Class;
    rdfs:label "Node Position";
    rdfs:comment "Visual position of a node (step) in the journey map canvas. Defines the x,y coordinates for rendering.".
:EdgeStyle a rdfs:Class;
    rdfs:label "Edge Style";
    rdfs:comment "Visual styling for edges (transitions) in the journey map. Controls appearance such as color, width, and line type.".
:CanvasViewport a rdfs:Class;
    rdfs:label "Canvas Viewport";
    rdfs:comment "Viewport state for the journey map canvas. Tracks zoom level and pan position for the visual editor.".
:position a rdf:Property;
    rdfs:label "position";
    rdfs:comment "The visual position of a step node in the canvas coordinate system.";
    rdfs:domain <http://localhost:4321/vocab/ns#Step>;
    rdfs:range :NodePosition.
:x a rdf:Property;
    rdfs:label "x";
    rdfs:comment "X coordinate of a node position in the canvas.";
    rdfs:domain :NodePosition;
    rdfs:range xsd:decimal.
:y a rdf:Property;
    rdfs:label "y";
    rdfs:comment "Y coordinate of a node position in the canvas.";
    rdfs:domain :NodePosition;
    rdfs:range xsd:decimal.
:style a rdf:Property;
    rdfs:label "style";
    rdfs:comment "The visual styling applied to a transition edge.";
    rdfs:domain <http://localhost:4321/vocab/ns#Transition>;
    rdfs:range :EdgeStyle.
:color a rdf:Property;
    rdfs:label "color";
    rdfs:comment "Color value for edge styling (e.g., hex color code).";
    rdfs:domain :EdgeStyle;
    rdfs:range xsd:string.
:width a rdf:Property;
    rdfs:label "width";
    rdfs:comment "Line width for edge rendering in pixels.";
    rdfs:domain :EdgeStyle;
    rdfs:range xsd:decimal.
:zoom a rdf:Property;
    rdfs:label "zoom";
    rdfs:comment "Zoom level of the canvas viewport (1.0 = 100%).";
    rdfs:domain :CanvasViewport;
    rdfs:range xsd:decimal.
