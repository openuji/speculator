---
interface Props {
  kind?: "note" | "warning" | "example" | "issue";
  title?: string;
}

const { kind = "note", title } = Astro.props;
const badgeTone = kind === "warning" ? "warn" : kind === "issue" ? "danger" : "accent";
---

<aside class={`ui-callout ui-callout-${kind}`}>
  <header>
    <span class={`ui-badge ui-badge-${badgeTone}`}>{title ?? kind}</span>
  </header>
  <div>
    <slot />
  </div>
</aside>
