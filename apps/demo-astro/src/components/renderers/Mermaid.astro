---
interface Props {
  code: string;
  id?: string;
}

const { code, id } = Astro.props;
---

<div class="mermaid-shell" id={id}>
  <pre class="mermaid">{code}</pre>
</div>

<script>
  const runtime = window as Window & {
    __astroDemoMermaidBoot?: boolean;
    __astroDemoMermaidInit?: boolean;
  };

  const renderMermaid = async () => {
    const mermaidModule = await import("mermaid/dist/mermaid.esm.min.mjs");
    const mermaid = mermaidModule.default;

    if (!runtime.__astroDemoMermaidInit) {
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      mermaid.initialize({
        startOnLoad: false,
        theme: prefersDark ? "dark" : "default",
        securityLevel: "strict",
      });
      runtime.__astroDemoMermaidInit = true;
    }

    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>("pre.mermaid:not([data-processed])")
    );
    if (nodes.length === 0) {
      return;
    }

    await mermaid.run({ nodes });
  };

  if (!runtime.__astroDemoMermaidBoot) {
    runtime.__astroDemoMermaidBoot = true;

    renderMermaid().catch((error) => {
      console.error("[mermaid] render failed:", error);
    });

    window.addEventListener("astro:after-swap", () => {
      renderMermaid().catch((error) => {
        console.error("[mermaid] render failed:", error);
      });
    });
  } else {
    renderMermaid().catch((error) => {
      console.error("[mermaid] render failed:", error);
    });
  }
</script>
