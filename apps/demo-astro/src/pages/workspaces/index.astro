---
import ThemeLayout from "@/layouts/ThemeLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import Panel from "@/components/ui/Panel.astro";
import { loadWorkspaces } from "@/lib/load-workspaces";

const data = await loadWorkspaces();
const totalDocuments = data.documents.length;
const totalErrors = data.workspaces.reduce(
  (sum, workspace) => sum + workspace.errorCount,
  0
);
const totalWarnings = data.workspaces.reduce(
  (sum, workspace) => sum + workspace.warningCount,
  0
);
---

<ThemeLayout title="Workspace Showcase | Speculator Studio Theme">
  <section class="hero">
    <Badge tone="accent">Workspace Showcase</Badge>
    <h1>Two isolated workspaces, one shared rendering shell</h1>
    <p>
      `ed-clean` demonstrates reference-safe authoring, includes, and mixed HTML/Markdown parsing.
      `ed-to-lint` intentionally triggers diagnostics across workspace, document, and reference rules.
    </p>

    <div class="button-row">
      <a href="/workspaces" class="btn btn-primary">Workspace Hub</a>
      <a href="/vocab/ns/index.html" class="btn btn-secondary">Core Vocabulary Output</a>
    </div>

    <div class="hero-grid">
      <Panel title="Documents">
        <p>
          <strong>{totalDocuments}</strong> documents generated from a mixed discovery model.
        </p>
      </Panel>
      <Panel title="Lint Overview">
        <p>
          <strong>{totalErrors}</strong> errors and <strong>{totalWarnings}</strong> warnings across all
          workspaces.
        </p>
      </Panel>
    </div>
  </section>

  <section class="section">
    <h2>Workspace Hub</h2>
    <div class="card-grid workspace-grid">
      {data.workspaces.map((workspace) => (
        <section id={`workspace-${workspace.key}`} class="workspace-panel-wrap">
          <Panel
            title={workspace.key}
            description={`${workspace.documents.length} docs · ${workspace.errorCount} errors · ${workspace.warningCount} warnings`}
            class="workspace-panel"
          >
            {workspace.buildErrors.length > 0 && (
              <div class="workspace-build-errors">
                <Badge tone="danger">Build Issues</Badge>
                <ul>
                  {workspace.buildErrors.map((error) => (
                    <li>{error}</li>
                  ))}
                </ul>
              </div>
            )}

            <div class="workspace-docs">
              <h3>Documents</h3>
              <ul>
                {workspace.documents.map((document) => (
                  <li>
                    <a href={document.route}>{document.title}</a>
                    <span>
                      {document.errorCount} errors · {document.warningCount} warnings
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="workspace-rules">
              <h3>Rule Summary</h3>
              <ul>
                {workspace.ruleSummary.map((rule) => (
                  <li>
                    <code>{rule.code}</code>
                    <span>
                      {rule.count} total ({rule.errors} errors, {rule.warnings} warnings)
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </Panel>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Generated Artifact Links</h2>
    <div class="card-grid">
      <Panel title="Search Index" description="Generated by speculator-search at build time.">
        <a href="/search-index.json">/search-index.json</a>
      </Panel>
      <Panel title="Core Vocabulary" description="Generated with vocab-build (ED mode).">
        <a href="/vocab/ns/index.html">/vocab/ns/index.html</a>
      </Panel>
      <Panel title="UI Vocabulary" description="Generated with vocab-build (ED mode).">
        <a href="/vocab/ui/index.html">/vocab/ui/index.html</a>
      </Panel>
    </div>
  </section>
</ThemeLayout>

<style>
  .workspace-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .workspace-panel {
    display: grid;
    gap: 1rem;
  }

  .workspace-panel-wrap {
    margin: 0;
  }

  .workspace-build-errors ul,
  .workspace-docs ul,
  .workspace-rules ul {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
  }

  .workspace-docs li,
  .workspace-rules li {
    margin-bottom: 0.35rem;
    color: var(--ui-ink-2);
    font-size: 0.88rem;
  }

  .workspace-docs a {
    margin-right: 0.35rem;
  }

  .workspace-rules code {
    margin-right: 0.35rem;
    font-size: 0.78rem;
  }
</style>
