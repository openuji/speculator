---
import ThemeLayout from "@/layouts/ThemeLayout.astro";
import Panel from "@/components/ui/Panel.astro";
import Badge from "@/components/ui/Badge.astro";
import { site } from "@/theme/site";

const features = [
  {
    title: "Workspace-first rendering",
    copy: "The demo builds two isolated workspaces, each with multiple dependent specs and mixed Markdown/HTML inputs.",
  },
  {
    title: "Intentional lint walkthrough",
    copy: "`ed-to-lint` triggers workspace/document/reference diagnostics while `ed-clean` stays stable for contrast.",
  },
  {
    title: "Build-time artifacts",
    copy: "Search index JSON plus vocabulary outputs are generated before dev/build and linked from the hub.",
  },
];
---

<ThemeLayout>
  <section class="hero">
    <Badge tone="accent">Token-driven Theme Starter</Badge>
    <h1>{site.title}</h1>
    <p>
      A Tailwind v4 Astro showcase for the Speculator ecosystem. Theme design is controlled by token presets,
      and global header search opens a modal with weighted results across workspace documents.
    </p>

    <div class="button-row">
      <a href="/workspaces" class="btn btn-primary">Open Workspace Showcase</a>
      <a href="/search-index.json" class="btn btn-secondary">Inspect Search Index</a>
    </div>

    <div class="hero-grid">
      <Panel
        title="Theme Overrides"
        description="Switch `site.themePreset` to reskin the app without touching CSS selectors or component templates."
      />
      <Panel
        title="Global Search Modal"
        description="Focus the header search or press Cmd/Ctrl+K to query all workspace documents with contextual ranking."
      />
    </div>
  </section>

  <section class="section">
    <h2>What This Demo Exercises</h2>
    <div class="card-grid">
      {features.map((feature) => (
        <Panel title={feature.title} description={feature.copy} />
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Submission readiness checklist</h2>
    <div class="card-grid">
      {site.submitReadyChecklist.map((item) => (
        <Panel>
          <p>{item}</p>
        </Panel>
      ))}
    </div>
  </section>
</ThemeLayout>
