{
    "name": "@openuji/speculator-search",
    "version": "0.1.0",
    "description": "Search functionality for Speculator workspace AST with optional anchor mapping",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "imports": {
        "#src/*": "./dist/*.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "peerDependencies": {
        "@openuji/speculator": "workspace:*"
    },
    "dependencies": {
        "@openuji/speculator": "workspace:*"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "search",
        "ast",
        "specification",
        "indexing",
        "speculator"
    ],
    "license": "MIT"
}