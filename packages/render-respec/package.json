{
    "name": "@openuji/render-respec",
    "version": "0.1.1",
    "description": "Generate ReSpec-compatible HTML from specification source files using Speculator AST pipeline",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "render-respec": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc && npm run postbuild",
        "prepack": "pnpm build",
        "postbuild": "cp -r src/templates dist/",
        "dev": "tsc --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "respec",
        "specification",
        "html",
        "renderer",
        "speculator",
        "w3c"
    ],
    "license": "MIT",
    "dependencies": {
        "@openuji/speculator": "workspace:*",
        "@openuji/speculator-lint": "workspace:*",
        "commander": "^12.0.0",
        "nunjucks": "^3.2.4",
        "prettier": "^3.1.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/nunjucks": "^3.2.6",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "lint-staged": {
        "src/**/!(*.generated).ts": [
            "eslint --fix --max-warnings 0",
            "bash -c 'pnpm typecheck'",
            "bash -c 'pnpm test --run'"
        ]
    }
}