{
  "name": "@openuji/speculator-emit",
  "version": "0.1.0",
  "description": "Deterministic Markdown/MDX emitter for Speculator AST",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speculator-emit": "bin/speculator-emit.js"
  },
  "imports": {
    "#src/*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "speculator",
    "markdown",
    "mdx",
    "serializer",
    "ast"
  ],
  "license": "MIT",
  "dependencies": {
    "@openuji/bikeshed-migrate": "workspace:*",
    "@openuji/speculator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
