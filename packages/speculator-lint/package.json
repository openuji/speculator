{
    "name": "@openuji/speculator-lint",
    "version": "0.2.1",
    "description": "Standalone linter for Speculator workspace AST with configurable validation rules",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "speculator-lint": "bin/speculator-lint.js"
    },
    "imports": {
        "#src/*": "./dist/*.js"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "pnpm build",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts --max-warnings 0",
        "lint:fix": "eslint src --ext .ts --fix",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "dependencies": {
        "@openuji/speculator": "workspace:*"
    },
    "files": [
        "dist",
        ".speculatorlintrc.example.json"
    ],
    "keywords": [
        "linter",
        "ast",
        "specification",
        "validation",
        "speculator"
    ],
    "license": "MIT",
    "lint-staged": {
        "src/**/!(*.generated).ts": [
            "eslint --fix --max-warnings 0",
            "bash -c 'pnpm typecheck'",
            "bash -c 'pnpm test --run'"
        ]
    }
}