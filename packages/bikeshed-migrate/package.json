{
    "name": "@openuji/bikeshed-migrate",
    "version": "0.1.0",
    "description": "Migration tool: converts Bikeshed (.bs) specs to Speculator-compatible index.md + config.json",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "bikeshed-migrate": "dist/cli.js"
    },
    "imports": {
        "#src/*": "./dist/*.js"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "pnpm build",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/hast": "^3.0.4",
        "@types/mdast": "^4.0.4",
        "@types/node": "^22.10.0",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    },
    "dependencies": {
        "hast-util-from-html": "^2.0.3",
        "hast-util-to-html": "^9.0.5",
        "remark-parse": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "bikeshed",
        "speculator",
        "migration",
        "specification",
        "w3c"
    ],
    "license": "MIT"
}
