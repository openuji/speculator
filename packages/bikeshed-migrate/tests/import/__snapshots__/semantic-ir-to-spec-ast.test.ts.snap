          },
          "id": "accessibility",
          "number": "6",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "Thanks to Brandon Walderman, Leo Lee, Andrew Nolan, David Bokan, Khushal Sagar, Hannah Van Opstal, Sushanth Rajasankar for the initial explainer, proposals and discussions that established the foundation for this specification.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Also many thanks to Alex Nahas and Jason McGhee for sharing early implementation experience.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Finally, thanks to the participants of the Web Machine Learning Community Group for feedback and suggestions.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Acknowledgements",
              },
            ],
            "depth": 2,
            "id": "acknowledgements",
            "type": "heading",
          },
          "id": "acknowledgements",
          "number": "7",
          "type": "section",
        },
        {
          "boilerplate": "conformance",
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Conformance requirements are expressed with a combination of descriptive assertions and RFC 2119 terminology. The key words “MUST”, “MUST NOT”, “REQUIRED”, “SHALL”, “SHALL NOT”, “SHOULD”, “SHOULD NOT”, “RECOMMENDED”, “MAY”, and “OPTIONAL” in the normative parts of this document are to be interpreted as described in RFC 2119. However, for readability, these words do not appear in all uppercase letters in this specification.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "All of the text of this specification is normative except sections explicitly marked as non-normative, examples, and notes. ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC2119]",
                        },
                      ],
                      "forcedNormative": true,
                      "key": "RFC2119",
                      "kind": "normative",
                      "source": {
                        "kind": "biblio",
                      },
                      "type": "cite",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Examples in this specification are introduced with the words “for example” or are set apart from the normative text with ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "class="example"",
                    },
                    {
                      "type": "text",
                      "value": ", like this:",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "This is an example of an informative example.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "example",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Informative notes begin with the word “Note” and are set apart from the normative text with ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "class="note"",
                    },
                    {
                      "type": "text",
                      "value": ", like this:",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Note, this is an informative note.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "note",
                  "type": "note",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Document conventions",
                  },
                ],
                "depth": 3,
                "id": "w3c-conventions",
                "type": "heading",
              },
              "id": "w3c-conventions",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Conformance",
              },
            ],
            "depth": 2,
            "id": "w3c-conformance",
            "type": "heading",
          },
          "id": "w3c-conformance",
          "omitted": true,
          "type": "section",
        },
