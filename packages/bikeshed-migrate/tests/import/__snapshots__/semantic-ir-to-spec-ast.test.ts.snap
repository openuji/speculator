                  "children": [
                    {
                      "items": [
                        {
                          "description": [
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "Registers the provided context (tools) with the browser. This method clears any pre-existing tools and other context before registering the new ones.",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "term": [
                            {
                              "children": [
                                {
                                  "type": "variable",
