                        },
                        {
                          "description": [
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "Registers a single tool without clearing the existing set of tools. The method throws an error, if a tool with the same name already exists, or if the ",
                                },
                                {
                                  "children": [
                                    {
                                      "children": [
