                                                  "xrefSpec": "webidl",
                                                },
                                              ],
                                              "type": "inlineCode",
                                              "value": "TypeError",
                                            },
                                            {
                                              "type": "text",
                                              "value": " when the backing "",
                                            },
                                            {
                                              "type": "inlineCode",
                                              "value": "JSON.stringify()",
                                            },
                                            {
                                              "type": "text",
                                              "value": "" yields undefined, e.g., "",
                                            },
                                            {
                                              "type": "inlineCode",
                                              "value": "inputSchema: { toJSON() {return HTMLDivElement;}}",
                                            },
                                            {
                                              "type": "text",
                                              "value": "", or "",
                                            },
                                            {
                                              "type": "inlineCode",
                                              "value": "inputSchema: { toJSON() {return undefined;}}",
                                            },
                                            {
                                              "type": "text",
                                              "value": "".",
                                            },
                                          ],
                                          "type": "paragraph",
                                        },
                                      ],
                                      "type": "listItem",
                                    },
                                    {
                                      "children": [
                                        {
                                          "children": [
                                            {
                                              "type": "text",
                                              "value": "Re-throws exceptions thrown by "",
                                            },
                                            {
                                              "type": "inlineCode",
                                              "value": "JSON.stringify()",
                                            },
                                            {
                                              "type": "text",
                                              "value": "", e.g., when "",
