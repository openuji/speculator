                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "a set of steps to invoke the tool.",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "Note: For tools registered imperatively, these steps will simply invoke the supplied ",
                            },
                            {
                              "children": [
                                {
                                  "children": [
                                    {
                                      "type": "text",
                                      "value": "ToolExecuteCallback",
