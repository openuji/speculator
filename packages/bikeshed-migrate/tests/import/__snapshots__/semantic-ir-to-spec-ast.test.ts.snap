                                              "type": "text",
                                              "value": "Throws a new ",
                                            },
                                            {
                                              "children": [
                                                {
                                                  "children": [
                                                    {
                                                      "type": "text",
                                                      "value": "TypeError",
                                                    },
                                                  ],
                                                  "source": {
                                                    "dataLinkType": "idl",
                                                    "href": "https://webidl.spec.whatwg.org/#exceptiondef-typeerror",
