                              "children": [
                                {
                                  "children": [
                                    {
                                      "type": "text",
                                      "value": "The serialization algorithm above throws exceptions in the following cases:",
                                    },
                                  ],
                                  "type": "paragraph",
                                },
                                {
                                  "children": [
                                    {
                                      "children": [
                                        {
                                          "children": [
