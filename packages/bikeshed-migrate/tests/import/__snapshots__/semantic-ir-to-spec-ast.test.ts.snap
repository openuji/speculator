exports[`mapSemanticIrToSpecAst > maps oidc semantic IR to figure/image asset nodes with mermaid source metadata intact > oidc-workspace 1`] = `
{
  "documents": [
    {
      "children": [
        {
          "boilerplate": "sotd",
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This report was published by the ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Solid Community Group",
                    },
                  ],
                  "source": {
                    "href": "https://www.w3.org/community/solid/",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://www.w3.org/community/solid/",
                },
                {
                  "type": "text",
                  "value": ". It is not a W3C Standard nor is it on the W3C Standards Track. Please note that under the ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "W3C Community Contributor License Agreement (CLA)",
                    },
                  ],
                  "source": {
                    "href": "https://www.w3.org/community/about/agreements/cla/",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://www.w3.org/community/about/agreements/cla/",
                },
                {
                  "type": "text",
                  "value": " there is a limited opt-out and other conditions apply. Learn more about ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "W3C Community and Business Groups",
                    },
                  ],
                  "source": {
                    "href": "https://www.w3.org/community/",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://www.w3.org/community/",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Status of This Document",
              },
            ],
            "depth": 2,
            "type": "heading",
          },
          "type": "section",
        },
        {
          "boilerplate": "abstract",
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "The Solid OpenID Connect (Solid-OIDC) specification defines how resource servers verify the identity of relying parties and end users based on the authentication performed by an OpenID provider. Solid-OIDC builds on top of OpenID Connect 1.0 for use within the Solid ecosystem.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Abstract",
              },
            ],
            "depth": 2,
            "id": "abstract",
            "type": "heading",
          },
          "id": "abstract",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "The ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Solid project",
                    },
                  ],
                  "source": {
                    "href": "https://solidproject.org/",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://solidproject.org/",
                },
                {
                  "type": "text",
                  "value": " aims to change the way web applications work today to improve privacy and user control of personal data by utilizing current standards, protocols, and tools, to facilitate building extensible and modular decentralized applications based on ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Linked Data",
                    },
                  ],
                  "source": {
                    "href": "https://www.w3.org/standards/semanticweb/data",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://www.w3.org/standards/semanticweb/data",
                },
                {
                  "type": "text",
                  "value": " principles.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "This specification is written for Authorization and Resource Server owners intending to implement Solid-OIDC. It is also useful to Solid application developers charged with implementing a Solid-OIDC client.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "The OAuth 2.0 ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC6749]",
                    },
                  ],
                  "key": "RFC6749",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc6749",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc6749",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": " and OpenID Connect Core 1.0 ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[OIDC-CORE]",
                    },
                  ],
                  "key": "OIDC-CORE",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-oidc-core",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-oidc-core",
                  "type": "cite",
                  "url": "https://openid.net/specs/openid-connect-core-1_0.html",
                },
                {
                  "type": "text",
                  "value": " web standards were published in October 2012 and November 2014, respectively. Since publication they’ve seen rapid and widespread adoption across the industry, in turn gaining extensive "real-world" data and experience. The strengths of the protocols are now clear; however, in a changing eco-system where privacy and control of digital identities are becoming more pressing concerns, it is also clear that additional functionality is required.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "The additional functionality documented herein aims to address:",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Resource servers and their Authorization servers having no existing trust relationship with identity providers.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Ephemeral Clients as a first-order use-case.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
              ],
              "ordered": true,
              "type": "list",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "This section is non-normative",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "While the Solid-OIDC specification describes the structure of an ID Token for use in Solid, the definition of a global access token for use with Solid Resource Servers is beyond the scope of this specification.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Out of Scope",
                  },
                ],
                "depth": 3,
                "id": "intro-out-of-scope",
                "type": "heading",
              },
              "id": "intro-out-of-scope",
              "number": "1.1",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Introduction",
              },
            ],
            "depth": 2,
            "id": "intro",
            "type": "heading",
          },
          "id": "intro",
          "number": "1",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "This specification uses the terms "access token", "authorization server", "resource server" (RS), "token endpoint", "grant type", and "client" as defined by The OAuth 2.0 Authorization Framework ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC6749]",
                    },
                  ],
                  "key": "RFC6749",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc6749",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc6749",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Throughout this specification, we will use the term OpenID Provider (OP) in line with the terminology used in the Open ID Connect Core 1.0 specification (OIDC) ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[OIDC-CORE]",
                    },
                  ],
                  "key": "OIDC-CORE",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-oidc-core",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-oidc-core",
                  "type": "cite",
                  "url": "https://openid.net/specs/openid-connect-core-1_0.html",
                },
                {
                  "type": "text",
                  "value": ". It should be noted that this is distinct from the entity referred to as an Authorization Server by the OAuth 2.0 Authorization Framework (OAuth) ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC6749]",
                    },
                  ],
                  "key": "RFC6749",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc6749",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc6749",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "This specification also uses the following terms:",
                },
              ],
              "type": "paragraph",
            },
            {
              "items": [
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A WebID is a URI with an HTTP or HTTPS scheme which denotes an Agent (Person, Organization, Group, Device, etc.).",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "WebID as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[WEBID]",
                        },
                      ],
                      "key": "WEBID",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-webid",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-webid",
                      "type": "cite",
                      "url": "https://www.w3.org/2005/Incubator/webid/spec/identity/",
                    },
                  ],
                },
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A string representing a set of claims as a JSON object that is encoded in a JWS or JWE, enabling the claims to be digitally signed or MACed and/or encrypted.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "JSON Web Token (JWT) as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC7519]",
                        },
                      ],
                      "key": "RFC7519",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-rfc7519",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-rfc7519",
                      "type": "cite",
                    },
                  ],
                },
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A JSON object that represents a cryptographic key. The members of the object represent properties of the key, including its value.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "JSON Web Key (JWK) as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC7517]",
                        },
                      ],
                      "key": "RFC7517",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-rfc7517",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-rfc7517",
                      "type": "cite",
                    },
                  ],
                },
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A mechanism for sender-constraining OAuth tokens via a proof-of-possession mechanism on the application level.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "Demonstration of Proof-of-Possession at the Application Layer (DPoP) as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[DPOP]",
                        },
                      ],
                      "key": "DPOP",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-dpop",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-dpop",
                      "type": "cite",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop",
                    },
                  ],
                },
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A DPoP proof is a JWT that is signed (using JWS) using a private key chosen by the client.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "DPoP Proof as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[DPOP]",
                        },
                      ],
                      "key": "DPOP",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-dpop",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-dpop",
                      "type": "cite",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop",
                    },
                  ],
                },
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "An extension to the Authorization Code flow which mitigates the risk of an authorization code interception attack.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "Proof Key for Code Exchange (PKCE) as defined by ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC7636]",
                        },
                      ],
                      "key": "RFC7636",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-rfc7636",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-rfc7636",
                      "type": "cite",
                    },
                  ],
                },
              ],
              "type": "definitionList",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Terminology",
              },
            ],
            "depth": 2,
            "id": "terms",
            "type": "heading",
          },
          "id": "terms",
          "number": "2",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "In a decentralized ecosystem, such as Solid, an OP may be an identity-as-a-service vendor or, at the other end of the spectrum, a user-controlled OP. In either case, the user may be authenticating from a browser or an application.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Therefore, this specification assumes the use of the ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Authorization Code Flow",
                    },
                  ],
                  "source": {
                    "href": "https://openid.net/specs/openid-connect-core-1_0.html#CodeFlowSteps",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://openid.net/specs/openid-connect-core-1_0.html#CodeFlowSteps",
                },
                {
                  "type": "text",
                  "value": " with PKCE, in accordance with OAuth and OIDC best practices. It is also assumed that there are no preexisting trust relationships with the OP. This means that client registration, whether dynamic, or static, is entirely optional.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "This section is non-normative",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "In line with Linked Data principles, a WebID is a HTTP URI that, when dereferenced, resolves to a profile document that is structured data in an ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "RDF 1.1 format",
                        },
                      ],
                      "source": {
                        "href": "https://www.w3.org/TR/rdf11-concepts/",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://www.w3.org/TR/rdf11-concepts/",
                    },
                    {
                      "type": "text",
                      "value": ". This profile document allows people to link with others to grant access to identity resources as they see fit. WebIDs underpin Solid and are used as a primary identifier for Users in this specification.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "WebIDs",
                  },
                ],
                "depth": 3,
                "id": "concepts-webids",
                "type": "heading",
              },
              "id": "concepts-webids",
              "number": "3.1",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Core Concepts",
              },
            ],
            "depth": 2,
            "id": "concepts",
            "type": "heading",
          },
          "id": "concepts",
          "number": "3",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Details of the flow are available in ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[SOLID-OIDC-PRIMER]",
                    },
                  ],
                  "key": "SOLID-OIDC-PRIMER",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-solid-oidc-primer",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-solid-oidc-primer",
                  "type": "cite",
                  "url": "https://solid.github.io/solid-oidc/primer/",
                },
              ],
              "type": "paragraph",
            },
            {
              "caption": [
                {
                  "type": "text",
                  "value": "Basic sequence of authenticating the user and the client.",
                },
              ],
              "children": [],
              "id": "fig-signature",
              "image": {
                "exists": true,
                "generatedFrom": "mermaid-mmd",
                "srcOriginal": "sequence.mmd.svg",
                "srcResolved": "sequence.mmd",
              },
              "type": "figure",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Basic Flow",
              },
            ],
            "depth": 2,
            "id": "basic-flow",
            "type": "heading",
          },
          "id": "basic-flow",
          "number": "4",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "OAuth and OIDC require the Client application to identify itself to the OP and RS by presenting a ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "client identifier",
                    },
                  ],
                  "source": {
                    "href": "https://tools.ietf.org/html/rfc6749#section-2.2",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://tools.ietf.org/html/rfc6749#section-2.2",
                },
                {
                  "type": "text",
                  "value": " (Client ID). Solid applications SHOULD use a URI that can be dereferenced as a ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Client ID Document",
                    },
                  ],
                  "source": {
                    "href": "#clientids-document",
                    "kind": "unknown",
                  },
                  "type": "link",
                  "url": "#clientids-document",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "solid/solid-oidc/78",
                        },
                      ],
                      "source": {
                        "className": [
                          "marker",
                        ],
                        "href": "https://github.com/solid/solid-oidc/issues/78",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://github.com/solid/solid-oidc/issues/78",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Specify the client authentication method when using a Client Identifier",
                        },
                      ],
                      "source": {
                        "href": "https://github.com/solid/solid-oidc/issues/78",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://github.com/solid/solid-oidc/issues/78",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "informative": true,
              "noteType": "issue",
              "type": "note",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "When a Client Identifier is dereferenced, the resource MUST be serialized as an ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "application/ld+json",
                    },
                    {
                      "type": "text",
                      "value": " document unless content negotiation requires a different outcome.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "The serialized JSON form of a Client ID Document MUST use the normative JSON-LD ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "@context",
                    },
                    {
                      "type": "text",
                      "value": " provided at ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "https://www.w3.org/ns/solid/oidc-context.jsonld",
                    },
                    {
                      "type": "text",
                      "value": " such that the resulting document produces a JSON serialization of an OIDC client registration, per the definition of client registration metadata from ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC7591]",
                        },
                      ],
                      "key": "RFC7591",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-rfc7591",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-rfc7591",
                      "type": "cite",
                    },
                    {
                      "type": "text",
                      "value": " section 2.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Also, the OP MUST dereference the Client ID Document and match any Client-supplied parameters with the values in the Client ID Document.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Further, the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "redirect_uri",
                    },
                    {
                      "type": "text",
                      "value": " provided by the Client MUST be included in the registration ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "redirect_uris",
                    },
                    {
                      "type": "text",
                      "value": " list.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "This example uses ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "JSON-LD",
                        },
                      ],
                      "source": {
                        "href": "https://www.w3.org/TR/json-ld/",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://www.w3.org/TR/json-ld/",
                    },
                    {
                      "type": "text",
                      "value": " for the Client ID Document:",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "https://app.example/id",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [],
                      "type": "codeBlock",
                      "value": "{
  "@context": ["https://www.w3.org/ns/solid/oidc-context.jsonld"],

  "client_id": "https://app.example/id",
  "client_name": "Solid Application Name",
  "redirect_uris": ["https://app.example/callback"],
  "post_logout_redirect_uris": ["https://app.example/logout"],
  "client_uri": "https://app.example/",
  "logo_uri" : "https://app.example/logo.png",
  "tos_uri" : "https://app.example/tos.html",
  "scope" : "openid profile offline_access webid",
  "grant_types" : ["refresh_token","authorization_code"],
  "response_types" : ["code"],
  "default_max_age" : 3600,
  "require_auth_time" : true
}",
                    },
                  ],
                  "informative": true,
                  "noteType": "example",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/95",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/95",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/95",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "Hosting Client ID Document on Solid Storage",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/95",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/95",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "This specification defines a JSON-LD context for use with OIDC Client ID Documents. This context is available at ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "https://www.w3.org/ns/solid/oidc-context.jsonld",
                        },
                        {
                          "type": "text",
                          "value": ". Client ID Documents that reference this JSON-LD context MUST use the HTTPS scheme.",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "NOTE: the ",
                            },
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "Solid-OIDC Vocabulary",
                                },
                              ],
                              "source": {
                                "href": "https://www.w3.org/ns/solid/oidc",
                                "kind": "external",
                              },
                              "type": "link",
                              "url": "https://www.w3.org/ns/solid/oidc",
                            },
                            {
                              "type": "text",
                              "value": " that is part of this context uses the HTTP scheme.",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "informative": true,
                      "noteType": "note",
                      "type": "note",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Full content of JSON-LD context can be also seen in ",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "Appendix A: Full JSON-LD context",
                            },
                          ],
                          "source": {
                            "href": "#full-jsonld-context",
                            "kind": "unknown",
                          },
                          "type": "link",
                          "url": "#full-jsonld-context",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "heading": {
                    "children": [
                      {
                        "type": "text",
                        "value": "JSON-LD context",
                      },
                    ],
                    "depth": 4,
                    "id": "jsonld-context",
                    "type": "heading",
                  },
                  "id": "jsonld-context",
                  "number": "5.1.1",
                  "type": "section",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Client ID Document",
                  },
                ],
                "depth": 3,
                "id": "clientids-document",
                "type": "heading",
              },
              "id": "clientids-document",
              "number": "5.1",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "For non-dereferencable identifiers, the Client MUST present a ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "client_id",
                    },
                    {
                      "type": "text",
                      "value": " value that has been registered with the OP via either OIDC dynamic or static registration. See also ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[OIDC-DYNAMIC-CLIENT-REGISTRATION]",
                        },
                      ],
                      "key": "OIDC-DYNAMIC-CLIENT-REGISTRATION",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-oidc-dynamic-client-registration",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-oidc-dynamic-client-registration",
                      "type": "cite",
                      "url": "https://openid.net/specs/openid-connect-registration-1_0.html",
                    },
                    {
                      "type": "text",
                      "value": ".",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "When requesting Dynamic Client Registration, the Client MUST specify the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "scope",
                    },
                    {
                      "type": "text",
                      "value": " in the metadata and include ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "webid",
                    },
                    {
                      "type": "text",
                      "value": " in its value (space-separated list).",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [],
                      "type": "codeBlock",
                      "value": "{  "client_name": "S-C-A Browser Demo Client App",  "application_type": "web",  "redirect_uris": [    "https://dynamic-client.example/auth"  ],  "subject_type": "pairwise",  "token_endpoint_auth_method": "client_secret_basic",  "scope" : "openid profile offline_access webid"}",
                    },
                  ],
                  "informative": true,
                  "noteType": "example",
                  "type": "note",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "OIDC Registration",
                  },
                ],
                "depth": 3,
                "id": "clientids-oidc",
                "type": "heading",
              },
              "id": "clientids-oidc",
              "number": "5.2",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Client Identifiers",
              },
            ],
            "depth": 2,
            "id": "clientids",
            "type": "heading",
          },
          "id": "clientids",
          "number": "5",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "Dereferencing the WebID URL results in a WebID Profile.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "solid/solid-oidc/76",
                        },
                      ],
                      "source": {
                        "className": [
                          "marker",
                        ],
                        "href": "https://github.com/solid/solid-oidc/issues/76",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://github.com/solid/solid-oidc/issues/76",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "WebIDs MUST use a secure protocol",
                        },
                      ],
                      "source": {
                        "href": "https://github.com/solid/solid-oidc/issues/76",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://github.com/solid/solid-oidc/issues/76",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "informative": true,
              "noteType": "issue",
              "type": "note",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "A WebID Profile lists the OpenID Providers who are trusted to issue tokens on behalf of the agent who controls the WebID. This prevents a malicious OpenID Provider from issuing otherwise valid ID Tokens for arbitrary WebIDs. An entity that verifies ID Tokens will use this mechanism to determine if the issuer is authoritative for the given WebID.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "caption": [
                    {
                      "type": "text",
                      "value": "WebID Profile specifying an OIDC issuer",
                    },
                  ],
                  "children": [
                    {
                      "children": [],
                      "type": "codeBlock",
                      "value": "PREFIX solid: <http://www.w3.org/ns/solid/terms#>

<#id> solid:oidcIssuer <https://oidc.example> .",
                    },
                  ],
                  "id": "example-75c9f7b4",
                  "type": "figure",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "To discover a list of valid issuers, the WebID Profile MUST be checked for the existence of statements matching",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [],
                  "type": "codeBlock",
                  "value": "?webid <http://www.w3.org/ns/solid/terms#oidcIssuer> ?iss .",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "where ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "?webid",
                    },
                    {
                      "type": "text",
                      "value": " is set to WebID. The ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "?iss",
                    },
                    {
                      "type": "text",
                      "value": " will result in an IRI denoting valid issuer for that WebID. The WebID Profile Document MUST include one or more statements matching the OIDC issuer pattern.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/80",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/80",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/80",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "OIDC issuer discovery when WebID is not publicly readable",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/80",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/80",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/92",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/92",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/92",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "In some cases OIDC issuer can't be disclosed in WebID Profile",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/92",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/92",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/91",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/91",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/91",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "consider support for OIDC self-issuer",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/91",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/91",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "A server hosting a WebID Profile Document MAY transmit the ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "http://www.w3.org/ns/solid/terms#oidcIssuer",
                        },
                        {
                          "type": "text",
                          "value": " values via Link Headers, but they MUST be the same as in the RDF representation. A client MUST treat the RDF in the body of the WebID Profile as canonical but MAY use the Link Header values as an optimization.",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "caption": [
                        {
                          "type": "text",
                          "value": "HTTP response Link Header (line breaks added for readibility)",
                        },
                      ],
                      "children": [
                        {
                          "children": [],
                          "type": "codeBlock",
                          "value": "Link: <https://oidc.example>;
      rel="http://www.w3.org/ns/solid/terms#oidcIssuer";
      anchor="#id"",
                        },
                      ],
                      "id": "example-3821d21b",
                      "type": "figure",
                    },
                  ],
                  "heading": {
                    "children": [
                      {
                        "type": "text",
                        "value": "OIDC Issuer Discovery via Link Headers",
                      },
                    ],
                    "depth": 4,
                    "id": "oidc-issuer-discovery-link-headers",
                    "type": "heading",
                  },
                  "id": "oidc-issuer-discovery-link-headers",
                  "number": "6.1.1",
                  "type": "section",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "OIDC Issuer Discovery",
                  },
                ],
                "depth": 3,
                "id": "oidc-issuer-discovery",
                "type": "heading",
              },
              "id": "oidc-issuer-discovery",
              "number": "6.1",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "WebID Profile",
              },
            ],
            "depth": 2,
            "id": "webid-profile",
            "type": "heading",
          },
          "id": "webid-profile",
          "number": "6",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "Solid-OIDC uses scope values, as defined in ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC6749]",
                    },
                  ],
                  "key": "RFC6749",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc6749",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc6749",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": " Section 3.3 and ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[OIDC-CORE]",
                    },
                  ],
                  "key": "OIDC-CORE",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-oidc-core",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-oidc-core",
                  "type": "cite",
                  "url": "https://openid.net/specs/openid-connect-core-1_0.html",
                },
                {
                  "type": "text",
                  "value": " Section 5.4 to specify what information is made available as Claim Values.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Solid-OIDC defines the following ",
                },
                {
                  "type": "inlineCode",
                  "value": "scope",
                },
                {
                  "type": "text",
                  "value": " value for use with claim requests:",
                },
              ],
              "type": "paragraph",
            },
            {
              "items": [
                {
                  "description": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "REQUIRED. This scope requests access to the End-User’s ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "webid",
                        },
                        {
                          "type": "text",
                          "value": " Claim.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "term": [
                    {
                      "type": "text",
                      "value": "webid",
                    },
                  ],
                },
              ],
              "type": "definitionList",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Requesting the WebID Claim using a Scope Value",
              },
            ],
            "depth": 2,
            "id": "webid-scope",
            "type": "heading",
          },
          "id": "webid-scope",
          "number": "7",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "In accordance with Best Current Practice ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC9700]",
                    },
                  ],
                  "key": "RFC9700",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc9700",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc9700",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": ", defense against ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Mix-Up Attacks",
                    },
                  ],
                  "source": {
                    "href": "https://www.rfc-editor.org/rfc/rfc9700.html#section-4.4",
                    "kind": "external",
                  },
                  "type": "link",
                  "url": "https://www.rfc-editor.org/rfc/rfc9700.html#section-4.4",
                },
                {
                  "type": "text",
                  "value": " is required in Solid-OIDC as clients are expected to interact with more than one OP. To this end, this specification adopts the mechanism defined in ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[RFC9207]",
                    },
                  ],
                  "key": "RFC9207",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-rfc9207",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-rfc9207",
                  "type": "cite",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "The OP MUST include the ",
                },
                {
                  "type": "inlineCode",
                  "value": "iss",
                },
                {
                  "type": "text",
                  "value": " query parameter alongside the authorization code when redirecting the user agent back to the Client’s redirect_uri. The value of the ",
                },
                {
                  "type": "inlineCode",
                  "value": "iss",
                },
                {
                  "type": "text",
                  "value": " parameter MUST be the Issuer Identifier of the OP, as defined in ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[OIDC-CORE]",
                    },
                  ],
                  "key": "OIDC-CORE",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-oidc-core",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-oidc-core",
                  "type": "cite",
                  "url": "https://openid.net/specs/openid-connect-core-1_0.html",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "caption": [
                {
                  "type": "text",
                  "value": "Example Authorization Response including the ",
                },
                {
                  "type": "inlineCode",
                  "value": "iss",
                },
                {
                  "type": "text",
                  "value": " query parameter",
                },
              ],
              "children": [
                {
                  "children": [],
                  "type": "codeBlock",
                  "value": "HTTP/1.1 302 Found
Location: https://client.example.com/callback?
                                        code=n0esc392ae491076
                                        &state=af0ifjsldkj
                                        &iss=https%3A%2F%2Fidp.example.com",
                },
              ],
              "id": "example-4e08796c",
              "type": "figure",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Upon receiving the authorization response, the Client MUST validate the ",
                },
                {
                  "type": "inlineCode",
                  "value": "iss",
                },
                {
                  "type": "text",
                  "value": " parameter:",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "The Client MUST check for the presence of the ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "iss",
                        },
                        {
                          "type": "text",
                          "value": " parameter.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "The Client MUST verify that the ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "iss",
                        },
                        {
                          "type": "text",
                          "value": " value matches the Issuer Identifier of the OP to which the authorization request was sent.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
              ],
              "ordered": false,
              "type": "list",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "If the ",
                },
                {
                  "type": "inlineCode",
                  "value": "iss",
                },
                {
                  "type": "text",
                  "value": " parameter is missing or does not match the expected value, the Client MUST reject the response, MUST NOT exchange the authorization code for tokens, and SHOULD signal an error to the user.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Issuer Validation after receiving the Authorization Code",
              },
            ],
            "depth": 2,
            "id": "iss-check",
            "type": "heading",
          },
          "id": "iss-check",
          "number": "8",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "Assuming one of the following options",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Client ID and Secret, and valid DPoP Proof (for dynamic and static registration)",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Dereferencable Client Identifier with a proper Client ID Document and valid DPoP Proof (for a Solid client identifier)",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "type": "listItem",
                },
              ],
              "ordered": false,
              "type": "list",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "the OP MUST return A DPoP-bound OIDC ID Token.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "When requesting a DPoP-bound OIDC ID Token, the Client MUST send a DPoP proof JWT that is valid according to the ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "OAuth 2.0 Demonstration of Proof-of-Possession at the Application Layer (DPoP) § section-5",
                        },
                      ],
                      "source": {
                        "href": "https://tools.ietf.org/html/draft-ietf-oauth-dpop#section-5",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop#section-5",
                    },
                    {
                      "type": "text",
                      "value": ". The DPoP proof JWT is used to bind the OIDC ID Token to a public key. See also: ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[DPOP]",
                        },
                      ],
                      "key": "DPOP",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-dpop",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-dpop",
                      "type": "cite",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop",
                    },
                    {
                      "type": "text",
                      "value": ".",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "With the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "webid",
                    },
                    {
                      "type": "text",
                      "value": " scope, the DPoP-bound OIDC ID Token payload MUST contain these claims:",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "webid",
                            },
                            {
                              "type": "text",
                              "value": " — The WebID claim MUST be the user’s WebID.",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "iss",
                            },
                            {
                              "type": "text",
                              "value": " — The issuer claim MUST be a valid URL of the OP instantiating this token.",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "aud",
                            },
                            {
                              "type": "text",
                              "value": " — The audience claim MUST be an array of values. The values MUST include the authorized party claim ",
                            },
                            {
                              "type": "inlineCode",
                              "value": "azp",
                            },
                            {
                              "type": "text",
                              "value": " and the string ",
                            },
                            {
                              "type": "inlineCode",
                              "value": "solid",
                            },
                            {
                              "type": "text",
                              "value": ". In the decentralized world of Solid-OIDC, the audience of an ID Token is not only the client (",
                            },
                            {
                              "type": "inlineCode",
                              "value": "azp",
                            },
                            {
                              "type": "text",
                              "value": "), but also any Solid Authorization Server at any accessible address on the world wide web (",
                            },
                            {
                              "type": "inlineCode",
                              "value": "solid",
                            },
                            {
                              "type": "text",
                              "value": "). See also: ",
                            },
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "JSON Web Token (JWT) § section-4.1.3",
                                },
                              ],
                              "source": {
                                "href": "https://www.rfc-editor.org/rfc/rfc7519#section-4.1.3",
                                "kind": "external",
                              },
                              "type": "link",
                              "url": "https://www.rfc-editor.org/rfc/rfc7519#section-4.1.3",
                            },
                            {
                              "type": "text",
                              "value": ".",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "azp",
                            },
                            {
                              "type": "text",
                              "value": " - The authorized party claim is used to identify the client (See also: ",
                            },
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "section 5. Client Identifiers",
                                },
                              ],
                              "source": {
                                "href": "#clientids",
                                "kind": "unknown",
                              },
                              "type": "link",
                              "url": "#clientids",
                            },
                            {
                              "type": "text",
                              "value": ").",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "iat",
                            },
                            {
                              "type": "text",
                              "value": " — The issued-at claim is the time at which the DPoP-bound OIDC ID Token was issued.",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "exp",
                            },
                            {
                              "type": "text",
                              "value": " — The expiration claim is the time at which the DPoP-bound OIDC ID Token becomes invalid.",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "inlineCode",
                              "value": "cnf",
                            },
                            {
                              "type": "text",
                              "value": " — The confirmation claim is used to identify the DPoP Public Key bound to the OIDC ID Token. See also: ",
                            },
                            {
                              "children": [
                                {
                                  "type": "text",
                                  "value": "OAuth 2.0 Demonstration of Proof-of-Possession at the Application Layer (DPoP) § section-7",
                                },
                              ],
                              "source": {
                                "href": "https://tools.ietf.org/html/draft-ietf-oauth-dpop#section-7",
                                "kind": "external",
                              },
                              "type": "link",
                              "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop#section-7",
                            },
                            {
                              "type": "text",
                              "value": ".",
                            },
                          ],
                          "type": "paragraph",
                        },
                      ],
                      "type": "listItem",
                    },
                  ],
                  "ordered": false,
                  "type": "list",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "An example OIDC ID Token:",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [],
                      "type": "codeBlock",
                      "value": "{
    "webid": "https://janedoe.com/web#id",
    "iss": "https://idp.example.com",
    "sub": "janedoe",
    "aud": ["https://client.example.com/client_id", "solid"],
    "azp": "https://client.example.com/client_id",
    "iat": 1311280970,
    "exp": 1311281970,
    "cnf":{
      "jkt":"0ZcOCORZNYy-DWpqq30jZyJGHTN0d2HglBV3uiguA4I"
    }
}",
                    },
                  ],
                  "informative": true,
                  "noteType": "example",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/26",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/26",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/26",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "Proposal: change webid claim to solid",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/26",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/26",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "solid/solid-oidc/47",
                            },
                          ],
                          "source": {
                            "className": [
                              "marker",
                            ],
                            "href": "https://github.com/solid/solid-oidc/issues/47",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/47",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "Presenting multiple WebIDs in an ID Token",
                            },
                          ],
                          "source": {
                            "href": "https://github.com/solid/solid-oidc/issues/47",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://github.com/solid/solid-oidc/issues/47",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "issue",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "An ID Token must be validated according to ",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "OIDC-CORE, Section 3.1.3.7",
                            },
                          ],
                          "source": {
                            "href": "https://openid.net/specs/openid-connect-core-1_0.html#IDTokenValidation",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://openid.net/specs/openid-connect-core-1_0.html#IDTokenValidation",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "The Verifying party MUST perform ",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "§ 6.1 OIDC Issuer Discovery",
                            },
                          ],
                          "source": {
                            "href": "#oidc-issuer-discovery",
                            "kind": "unknown",
                          },
                          "type": "link",
                          "url": "#oidc-issuer-discovery",
                        },
                        {
                          "type": "text",
                          "value": " using the value of the ",
                        },
                        {
                          "type": "inlineCode",
                          "value": "webid",
                        },
                        {
                          "type": "text",
                          "value": " claim to dereference the WebID Profile Document.",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Unless the verifying party acquires OP keys through some other means, or it chooses to reject tokens issued by this OP, the verifying party MUST follow OpenID Connect Discovery 1.0 ",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "[OIDC-DISCOVERY]",
                            },
                          ],
                          "key": "OIDC-DISCOVERY",
                          "source": {
                            "dataLinkType": "biblio",
                            "href": "#biblio-oidc-discovery",
                            "kind": "biblio",
                          },
                          "targetId": "biblio-oidc-discovery",
                          "type": "cite",
                          "url": "https://openid.net/specs/openid-connect-discovery-1_0.html",
                        },
                        {
                          "type": "text",
                          "value": " to find an OP’s signing keys (JWK).",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "heading": {
                    "children": [
                      {
                        "type": "text",
                        "value": "ID Token Validation",
                      },
                    ],
                    "depth": 4,
                    "id": "id-token-validation",
                    "type": "heading",
                  },
                  "id": "id-token-validation",
                  "number": "9.1.1",
                  "type": "section",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "DPoP-bound OIDC ID Token",
                  },
                ],
                "depth": 3,
                "id": "tokens-id",
                "type": "heading",
              },
              "id": "tokens-id",
              "number": "9.1",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Token Instantiation",
              },
            ],
            "depth": 2,
            "id": "tokens",
            "type": "heading",
          },
          "id": "tokens",
          "number": "9",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "When a Client performs an unauthenticated request to a protected resource, the Resource Server MUST respond with the HTTP ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "401",
                    },
                    {
                      "type": "text",
                      "value": " status code, and a ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "WWW-Authenticate",
                    },
                    {
                      "type": "text",
                      "value": " HTTP header. See also: ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC9110]",
                        },
                      ],
                      "key": "RFC9110",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-rfc9110",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-rfc9110",
                      "type": "cite",
                    },
                    {
                      "type": "text",
                      "value": "(11.6.1. WWW-Authenticate)",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "The ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "WWW-Authenticate",
                    },
                    {
                      "type": "text",
                      "value": " HTTP header MUST include an ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "as_uri",
                    },
                    {
                      "type": "text",
                      "value": " parameter unless the authentication scheme requires a different mechanism for discovering an associated authorization server.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Authorization Servers SHOULD implement User-Managed Access (UMA) 2.0 Grant for OAuth 2.0 Authorization ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[UMA]",
                        },
                      ],
                      "key": "UMA",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-uma",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-uma",
                      "type": "cite",
                      "url": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html",
                    },
                    {
                      "type": "text",
                      "value": ".",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Authorization Server Discovery",
                  },
                ],
                "depth": 3,
                "id": "authorization-server-discovery",
                "type": "heading",
              },
              "id": "authorization-server-discovery",
              "number": "10.1",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "For Authorization Servers that conform to ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[UMA]",
                        },
                      ],
                      "key": "UMA",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-uma",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-uma",
                      "type": "cite",
                      "url": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html",
                    },
                    {
                      "type": "text",
                      "value": ", the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "http://openid.net/specs/openid-connect-core-1_0.html#IDToken",
                    },
                    {
                      "type": "text",
                      "value": " profile MUST be supported. This profile MUST be advertised in the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "uma_profiles_supported",
                    },
                    {
                      "type": "text",
                      "value": " metadata of the Authorization Server discovery document ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "User-Managed Access (UMA) 2.0 Grant for OAuth 2.0 Authorization § rfc.section.2",
                        },
                      ],
                      "source": {
                        "href": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html#rfc.section.2",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html#rfc.section.2",
                    },
                    {
                      "type": "text",
                      "value": ".",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "When using the ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "http://openid.net/specs/openid-connect-core-1_0.html#IDToken",
                    },
                    {
                      "type": "text",
                      "value": " profile with an UMA-based Authorization Server, the Authorization Server MUST be capable of exchanging a valid Solid-OIDC ID Token ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "§ 9.1 DPoP-bound OIDC ID Token",
                        },
                      ],
                      "source": {
                        "href": "#tokens-id",
                        "kind": "unknown",
                      },
                      "type": "link",
                      "url": "#tokens-id",
                    },
                    {
                      "type": "text",
                      "value": " for an OAuth 2.0 Access Token.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "Note: Clients can push additional claims by requesting an upgraded RPT ",
                        },
                        {
                          "children": [
                            {
                              "type": "text",
                              "value": "User-Managed Access (UMA) 2.0 Grant for OAuth 2.0 Authorization § rfc.section.3.3.1",
                            },
                          ],
                          "source": {
                            "href": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html#rfc.section.3.3.1",
                            "kind": "external",
                          },
                          "type": "link",
                          "url": "https://docs.kantarainitiative.org/uma/wg/rec-oauth-uma-grant-2.0.html#rfc.section.3.3.1",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "note",
                  "type": "note",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Authorization Server MUST pefrom ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "§ 10.3 DPoP Validation",
                        },
                      ],
                      "source": {
                        "href": "#dpop-validation",
                        "kind": "unknown",
                      },
                      "type": "link",
                      "url": "#dpop-validation",
                    },
                    {
                      "type": "text",
                      "value": " and ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "§ 9.1.1 ID Token Validation",
                        },
                      ],
                      "source": {
                        "href": "#id-token-validation",
                        "kind": "unknown",
                      },
                      "type": "link",
                      "url": "#id-token-validation",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Obtaining an Access Token",
                  },
                ],
                "depth": 3,
                "id": "obtaining-access-token",
                "type": "heading",
              },
              "id": "obtaining-access-token",
              "number": "10.2",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "A DPoP Proof that is valid according to ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "DPoP Internet-Draft, Section 4.3",
                        },
                      ],
                      "source": {
                        "href": "https://tools.ietf.org/html/draft-ietf-oauth-dpop-04#section-4.3",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop-04#section-4.3",
                    },
                    {
                      "type": "text",
                      "value": ", MUST be present when a DPoP-bound OIDC ID Token is used.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "The DPoP-bound OIDC ID Token MUST be validated according to ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "DPoP Internet-Draft, Section 6",
                        },
                      ],
                      "source": {
                        "href": "https://tools.ietf.org/html/draft-ietf-oauth-dpop-04#section-6",
                        "kind": "external",
                      },
                      "type": "link",
                      "url": "https://tools.ietf.org/html/draft-ietf-oauth-dpop-04#section-6",
                    },
                    {
                      "type": "text",
                      "value": ", but the AS MAY perform additional verification in order to determine whether to grant access to the requested resource.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "DPoP Validation",
                  },
                ],
                "depth": 3,
                "id": "dpop-validation",
                "type": "heading",
              },
              "id": "dpop-validation",
              "number": "10.3",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Resource Access",
              },
            ],
            "depth": 2,
            "id": "resource",
            "type": "heading",
          },
          "id": "resource",
          "number": "10",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "An OpenID Provider that conforms to the Solid-OIDC specification MUST advertise it in the OpenID Connect Discovery 1.0 ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[OIDC-DISCOVERY]",
                    },
                  ],
                  "key": "OIDC-DISCOVERY",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-oidc-discovery",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-oidc-discovery",
                  "type": "cite",
                  "url": "https://openid.net/specs/openid-connect-discovery-1_0.html",
                },
                {
                  "type": "text",
                  "value": " resource by including ",
                },
                {
                  "type": "inlineCode",
                  "value": "webid",
                },
                {
                  "type": "text",
                  "value": " in its ",
                },
                {
                  "type": "inlineCode",
                  "value": "scopes_supported",
                },
                {
                  "type": "text",
                  "value": " metadata property.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [],
                  "type": "codeBlock",
                  "value": "{
    "scopes_supported": ["openid", "offline_access", "webid"]
}",
                },
              ],
              "informative": true,
              "noteType": "example",
              "type": "note",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Solid-OIDC Conformance Discovery",
              },
            ],
            "depth": 2,
            "id": "discovery",
            "type": "heading",
          },
          "id": "discovery",
          "number": "11",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "As this specification builds upon existing web standards, security considerations from OAuth, OIDC, PKCE, and the DPoP specifications may also apply unless otherwise indicated. The following considerations should be reviewed by implementors and system/s architects of this specification.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Some of the references within this specification point to documents with a Living Standard or Draft status, meaning their contents can still change over time. It is advised to monitor these documents, as such changes might have security implications.",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "In addition to above considerations, implementors should consider the Security Considerations in context of the Solid Protocol ",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "[SOLID-PROTOCOL]",
                    },
                  ],
                  "key": "SOLID-PROTOCOL",
                  "source": {
                    "dataLinkType": "biblio",
                    "href": "#biblio-solid-protocol",
                    "kind": "biblio",
                  },
                  "targetId": "biblio-solid-protocol",
                  "type": "cite",
                  "url": "https://solidproject.org/TR/protocol",
                },
                {
                  "type": "text",
                  "value": ".",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "All TLS requirements outlined in ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[BCP195]",
                        },
                      ],
                      "key": "BCP195",
                      "source": {
                        "dataLinkType": "biblio",
                        "href": "#biblio-bcp195",
                        "kind": "biblio",
                      },
                      "targetId": "biblio-bcp195",
                      "type": "cite",
                      "url": "https://www.rfc-editor.org/info/bcp195",
                    },
                    {
                      "type": "text",
                      "value": " apply to this specification.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "All tokens, Client, and User credentials MUST only be transmitted over TLS.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "TLS Requirements",
                  },
                ],
                "depth": 3,
                "id": "security-tls",
                "type": "heading",
              },
              "id": "security-tls",
              "number": "12.1",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "An AS SHOULD assign a fixed set of low trust policies to any client identified as anonymous.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Implementors SHOULD expire ephemeral Client IDs that are kept in server storage to mitigate the potential for a bad actor to fill server storage with unexpired or otherwise useless Client IDs.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Client IDs",
                  },
                ],
                "depth": 3,
                "id": "security-client-ids",
                "type": "heading",
              },
              "id": "security-client-ids",
              "number": "12.2",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Client secrets SHOULD NOT be stored in browser local storage. Doing so will increase the risk of data leaks should an attacker gain access to Client credentials.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Client Secrets",
                  },
                ],
                "depth": 3,
                "id": "security-client-secrets",
                "type": "heading",
              },
              "id": "security-client-secrets",
              "number": "12.3",
              "type": "section",
            },
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "This section is non-normative",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Clients are ephemeral, client registration is optional, and most Clients cannot keep secrets. These, among other factors, are what makes Client trust challenging.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "Client Trust",
                  },
                ],
                "depth": 3,
                "id": "security-client-trust",
                "type": "heading",
              },
              "id": "security-client-trust",
              "number": "12.4",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Security Considerations",
              },
            ],
            "depth": 2,
            "id": "security",
            "type": "heading",
          },
          "id": "security",
          "number": "12",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "This section is non-normative",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "With JWTs being extendable by design, there is potential for a privacy breach if OIDC ID Tokens get reused across multiple authorization servers. It is not unimaginable that a custom claim is added to the OIDC ID Token on instantiation. This addition may unintentionally give other authorization servers consuming the OIDC ID Token information about the user that they may not wish to share outside of the intended AS.",
                    },
                  ],
                  "type": "paragraph",
                },
              ],
              "heading": {
                "children": [
                  {
                    "type": "text",
                    "value": "OIDC ID Token Reuse",
                  },
                ],
                "depth": 3,
                "id": "privacy-token-reuse",
                "type": "heading",
              },
              "id": "privacy-token-reuse",
              "number": "13.1",
              "type": "section",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Privacy Considerations",
              },
            ],
            "depth": 2,
            "id": "privacy",
            "type": "heading",
          },
          "id": "privacy",
          "number": "13",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "This section is non-normative",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "The Solid Community Group would like to thank the following individuals for reviewing and providing feedback on the specification (in alphabetical order):",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [
                {
                  "type": "text",
                  "value": "Tim Berners-Lee, Justin Bingham, Sarven Capadisli, Aaron Coburn, Matthias Evering, Jamie Fiedler, Michiel de Jong, Ted Thibodeau Jr, Kjetil Kjernsmo, Mitzi László, Pat McBennett, Adam Migus, Jackson Morgan, Davi Ottenheimer, Justin Richer, severin-dsr, Henry Story, Michael Thornburgh, Emmet Townsend, Ruben Verborgh, Ricky White, Paul Worrall, Dmitri Zagidulin.",
                },
              ],
              "type": "paragraph",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Acknowledgments",
              },
            ],
            "depth": 2,
            "id": "acknowledgments",
            "type": "heading",
          },
          "id": "acknowledgments",
          "number": "14",
          "type": "section",
        },
        {
          "children": [
            {
              "children": [
                {
                  "type": "text",
                  "value": "The JSON-LD context is defined as:",
                },
              ],
              "type": "paragraph",
            },
            {
              "children": [],
              "type": "codeBlock",
              "value": "{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "oidc": "http://www.w3.org/ns/solid/oidc#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "client_id": {
      "@id": "@id",
      "@type": "@id"
    },
    "client_uri": {
      "@id": "oidc:client_uri",
      "@type": "@id"
    },
    "logo_uri": {
      "@id": "oidc:logo_uri",
      "@type": "@id"
    },
    "policy_uri": {
      "@id": "oidc:policy_uri",
      "@type": "@id"
    },
    "tos_uri": {
      "@id": "oidc:tos_uri",
      "@type": "@id"
    },
    "redirect_uris": {
      "@id": "oidc:redirect_uris",
      "@type": "@id",
      "@container": [
        "@id",
        "@set"
      ]
    },
    "require_auth_time": {
      "@id": "oidc:require_auth_time",
      "@type": "xsd:boolean"
    },
    "default_max_age": {
      "@id": "oidc:default_max_age",
      "@type": "xsd:integer"
    },
    "application_type": {
      "@id": "oidc:application_type"
    },
    "client_name": {
      "@id": "oidc:client_name"
    },
    "contacts": {
      "@id": "oidc:contacts"
    },
    "grant_types": {
      "@id": "oidc:grant_types"
    },
    "response_types": {
      "@id": "oidc:response_types"
    },
    "scope": {
      "@id": "oidc:scope"
    },
    "token_endpoint_auth_method": {
      "@id": "oidc:token_endpoint_auth_method"
    }
  }
}",
            },
          ],
          "heading": {
            "children": [
              {
                "type": "text",
                "value": "Appendix A: Full JSON-LD context",
              },
            ],
            "depth": 2,
            "id": "full-jsonld-context",
            "type": "heading",
          },
          "id": "full-jsonld-context",
          "type": "section",
        },
        {
          "boilerplate": "conformance",
          "children": [
            {
              "children": [
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Conformance requirements are expressed with a combination of descriptive assertions and RFC 2119 terminology. The key words “MUST”, “MUST NOT”, “REQUIRED”, “SHALL”, “SHALL NOT”, “SHOULD”, “SHOULD NOT”, “RECOMMENDED”, “MAY”, and “OPTIONAL” in the normative parts of this document are to be interpreted as described in RFC 2119. However, for readability, these words do not appear in all uppercase letters in this specification.",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "All of the text of this specification is normative except sections explicitly marked as non-normative, examples, and notes. ",
                    },
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "[RFC2119]",
                        },
                      ],
                      "forcedNormative": true,
                      "key": "RFC2119",
                      "kind": "normative",
                      "source": {
                        "kind": "biblio",
                      },
                      "type": "cite",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "type": "text",
                      "value": "Examples in this specification are introduced with the words “for example” or are set apart from the normative text with ",
                    },
                    {
                      "type": "inlineCode",
                      "value": "class="example"",
                    },
                    {
                      "type": "text",
                      "value": ", like this:",
                    },
                  ],
                  "type": "paragraph",
                },
                {
                  "children": [
                    {
                      "children": [
                        {
                          "type": "text",
                          "value": "This is an example of an informative example.",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "informative": true,
                  "noteType": "example",
                  "type": "note",
                },
                {
                  "children": [
